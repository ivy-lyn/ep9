+++ b/Sources/Fuzzilli/Profiles/Ep9Profile.swift
@@ -0,0 +1,69 @@
+// The ep9 profile (the ep9 repo's third_party/patches/fuzzilli/0001-ep9-profile.patch).
+//
+// ep9 is a JavaScript engine in Rust. `ep9 --reprl` runs the REPRL loop on fds 100-103 with a
+// fresh isolate per script; build it with SanitizerCoverage by the ep9 repo's
+// infra/fuzz/build-ep9.sh. Its `fuzzilli` builtin crashes in three ways:
+//   0: a Rust panic (SIGABRT), 1: a store to 0x41414141 (SIGSEGV),
+//   2: a trap instruction (SIGILL on x86-64, SIGTRAP on arm64).
+// A full GC heap ends the child with exit 71 and no status word: a failed run, not a crash.
+
+private let Ep9GcGenerator = CodeGenerator("Ep9GcGenerator") { b in
+    b.callFunction(b.createNamedVariable(forBuiltin: "gc"))
+}
+
+let ep9Profile = Profile(
+    processArgs: { randomize in
+        ["--reprl"]
+    },
+
+    processArgsReference: nil,
+
+    // A panic prints its backtrace to stderr, which Fuzzilli keeps in the crash file
+    // (infra/fuzz/triage.sh dedups by the panic text and the top frames).
+    processEnv: ["RUST_BACKTRACE": "1"],
+
+    maxExecsBeforeRespawn: 1000,
+
+    // The startup tests pick the value inside the interval.
+    timeout: Timeout.interval(300, 1500),
+
+    codePrefix: """
+        """,
+
+    codeSuffix: """
+        """,
+
+    ecmaVersion: ECMAScriptVersion.es6,
+
+    startupTests: [
+        // Check that the fuzzilli integration is available.
+        ("fuzzilli('FUZZILLI_PRINT', 'test')", .shouldSucceed),
+
+        // Check that the three crash kinds are detected.
+        ("fuzzilli('FUZZILLI_CRASH', 0)", .shouldCrash),
+        ("fuzzilli('FUZZILLI_CRASH', 1)", .shouldCrash),
+        ("fuzzilli('FUZZILLI_CRASH', 2)", .shouldCrash),
+    ],
+
+    additionalCodeGenerators: [
+        (Ep9GcGenerator, 5)
+    ],
+
+    additionalProgramTemplates: WeightedList<ProgramTemplate>([]),
+
+    disabledCodeGenerators: [],
+
+    disabledMutators: [],
+
+    additionalBuiltins: [
+        "gc": .function([] => .undefined)
+    ],
+
+    additionalObjectGroups: [],
+
+    additionalEnumerations: [],
+
+    additionalOptionsBags: [],
+
+    optionalPostProcessor: nil
+)
