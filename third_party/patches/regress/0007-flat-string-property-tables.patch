         let mut as_ranges_fn_match_block = Block::new("match value");
 
@@ -108,26 +108,26 @@ impl GenUnicode {
         let mut property_from_str_fn_match_block = Block::new("match s");
 
         for (name, name_enum, sets) in &property_sets {
+            // One flat table per property (no pointer per string, so no load-time fixups):
+            // the code points of all strings, then the end of each string.
+            let mut code_points = Vec::new();
+            let mut ends = Vec::new();
+            for codepoints in sets {
+                code_points.extend(codepoints.iter().map(|cp| cp.value().to_string()));
+                ends.push(code_points.len().to_string());
+            }
             self.scope.raw(format!(
-                "static {}: &[&[u32]; {}] = &[{}];",
+                "static {}: StringSetTable = StringSetTable {{ code_points: &[{}], ends: &[{}] }};",
                 name.to_uppercase(),
-                sets.len(),
-                sets.iter()
-                    .map(|codepoints| codepoints
-                        .iter()
-                        .map(|cp| cp.value().to_string())
-                        .collect::<Vec<String>>()
-                        .join(","))
-                    .map(|s| format!("&[{}],", s.as_str()))
-                    .collect::<Vec<String>>()
-                    .join("")
+                code_points.join(","),
+                ends.join(",")
             ));
 
             self.scope
                 .new_fn(format!("{}_sets", name.to_lowercase()))
                 .vis("pub(crate)")
-                .ret("&'static [&'static [u32]]")
-                .line(format!("{}.as_slice()", name.to_uppercase()))
+                .ret("StringSetTable")
+                .line(name.to_uppercase())
                 .doc(format!(
                     "Return the code point ranges of the '{}' Unicode property.",
                     name
