diff --git a/src/unicode.rs b/src/unicode.rs
index 8eef534..e9cb028 100644
--- a/src/unicode.rs
+++ b/src/unicode.rs
@@ -436,7 +436,29 @@ pub fn add_icase_code_points(mut input: CodePointSet) -> CodePointSet {
 
 pub(crate) enum PropertyEscapeKind {
     CharacterClass(&'static [Interval]),
-    StringSet(&'static [&'static [u32]]),
+    StringSet(StringSetTable),
+}
+
+/// The strings of a Unicode property of strings (`\p{RGI_Emoji}` with the `v` flag), stored
+/// flat: the code points of all strings one after another, and the end of each string in
+/// `code_points`. A table holds two pointers, not one per string, so a binary needs no
+/// load-time fixup per string.
+#[derive(Debug, Copy, Clone)]
+pub(crate) struct StringSetTable {
+    pub(crate) code_points: &'static [u32],
+    pub(crate) ends: &'static [u32],
+}
+
+impl StringSetTable {
+    /// The strings of the table, in table order.
+    pub(crate) fn iter(self) -> impl Iterator<Item = &'static [u32]> {
+        let mut start = 0;
+        self.ends.iter().map(move |&end| {
+            let s = &self.code_points[start..end as usize];
+            start = end as usize;
+            s
+        })
+    }
 }
 
 #[derive(Debug, Copy, Clone)]
@@ -495,6 +517,36 @@ pub(crate) fn unicode_property_from_str(
 #[cfg(test)]
 mod tests {
     use super::*;
+
+    #[test]
+    fn string_tables_are_well_formed() {
+        use crate::unicodetables::UnicodeStringProperty::*;
+        let parts = [
+            BasicEmoji,
+            EmojiKeycapSequence,
+            RGIEmojiFlagSequence,
+            RGIEmojiModifierSequence,
+            RGIEmojiTagSequence,
+            RGIEmojiZWJSequence,
+        ];
+        let mut all = 0;
+        for p in parts.iter().chain([RGIEmoji].iter()) {
+            let t = string_property_sets(p);
+            assert_eq!(
+                t.ends.last().copied(),
+                Some(t.code_points.len() as u32),
+                "{p:?}"
+            );
+            assert!(t.ends.windows(2).all(|w| w[0] < w[1]), "{p:?}");
+            assert!(t.iter().all(|s| !s.is_empty()), "{p:?}");
+            assert_eq!(t.iter().count(), t.ends.len(), "{p:?}");
+            if !matches!(p, RGIEmoji) {
+                all += t.ends.len();
+            }
+        }
+        // RGI_Emoji is the union of the six sequence properties.
+        assert_eq!(string_property_sets(&RGIEmoji).ends.len(), all);
+    }
     #[cfg(not(feature = "std"))]
     use hashbrown::HashMap;
     #[cfg(feature = "std")]
