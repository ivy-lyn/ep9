+//! Properties of strings (`\p{...}` with the `v` flag), read from the flat string tables:
+//! the first and the last string of each table match whole, and a prefix of a sequence
+//! does not.
+
+use regress::Regex;
+
+fn whole(property: &str, s: &str) -> bool {
+    let re = Regex::with_flags(&format!("^\\p{{{property}}}$"), "v").unwrap();
+    re.find(s).is_some()
+}
+
+fn text(cps: &[u32]) -> String {
+    cps.iter().map(|&c| char::from_u32(c).unwrap()).collect()
+}
+
+#[test]
+fn first_and_last_strings_match() {
+    let cases: &[(&str, &[u32], &[u32])] = &[
+        ("Basic_Emoji", &[0x231A], &[0x1F6F3, 0xFE0F]),
+        (
+            "Emoji_Keycap_Sequence",
+            &[0x23, 0xFE0F, 0x20E3],
+            &[0x39, 0xFE0F, 0x20E3],
+        ),
+        (
+            "RGI_Emoji_Flag_Sequence",
+            &[0x1F1E6, 0x1F1E8],
+            &[0x1F1FF, 0x1F1FC],
+        ),
+        (
+            "RGI_Emoji_Modifier_Sequence",
+            &[0x261D, 0x1F3FB],
+            &[0x1FAF8, 0x1F3FF],
+        ),
+        (
+            "RGI_Emoji_Tag_Sequence",
+            &[
+                0x1F3F4, 0xE0067, 0xE0062, 0xE0065, 0xE006E, 0xE0067, 0xE007F,
+            ],
+            &[
+                0x1F3F4, 0xE0067, 0xE0062, 0xE0077, 0xE006C, 0xE0073, 0xE007F,
+            ],
+        ),
+        (
+            "RGI_Emoji_ZWJ_Sequence",
+            &[0x1F468, 0x200D, 0x2764, 0xFE0F, 0x200D, 0x1F468],
+            &[0x1F9D1, 0x1F3FF, 0x200D, 0x1FAEF, 0x200D, 0x1F9D1, 0x1F3FE],
+        ),
+    ];
+    for &(property, first, last) in cases {
+        for s in [first, last] {
+            assert!(whole(property, &text(s)), "{property} {s:x?}");
+            assert!(whole("RGI_Emoji", &text(s)), "RGI_Emoji {s:x?}");
+            if s.len() > 1 {
+                let prefix = &s[..s.len() - 1];
+                assert!(
+                    !whole(property, &text(prefix)),
+                    "{property} prefix {prefix:x?}"
+                );
+            }
+        }
+    }
+}
