+#[cfg(feature = "utf16")]
+#[derive(Debug, Copy, Clone)]
+#[non_exhaustive]
+pub enum Text<'t> {
+    /// UTF-16: a surrogate pair is one character (the JavaScript `u` and `v` flags).
+    Utf16(&'t [u16]),
+    /// UCS-2: each code unit is one character (no `u` or `v` flag).
+    Ucs2(&'t [u16]),
+}
