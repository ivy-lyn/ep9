+/// The step counter of one search: a step is a backtrack, a loop iteration or a start
+/// position. Every `chunk` steps it calls `poll`, and it stops the search when `poll` returns
+/// true or the budget is spent.
+struct Meter<'a> {
+    /// Steps left in the current chunk.
+    fuel: u32,
+    /// The size of the current chunk (the steps it counts when it runs out).
+    chunk: u32,
+    /// Steps counted in the chunks that ran out.
+    used: u64,
+    /// The step budget (`None`: no limit).
+    budget: Option<u64>,
+    /// The steps between two polls.
+    interval: u32,
+    /// The interrupt poll (`None`: no poll).
+    poll: Option<&'a mut (dyn FnMut() -> bool + 'a)>,
+    /// Why the search stopped, once it has.
+    stopped: Option<Stopped>,
+}
+
+impl core::fmt::Debug for Meter<'_> {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        f.debug_struct("Meter")
+            .field("fuel", &self.fuel)
+            .field("used", &self.used)
+            .field("budget", &self.budget)
+            .field("interval", &self.interval)
+            .field("stopped", &self.stopped)
+            .finish()
+    }
+}
+
+impl<'a> Meter<'a> {
+    /// A meter that never stops a search.
+    fn unlimited() -> Self {
+        Meter {
+            fuel: u32::MAX,
+            chunk: u32::MAX,
+            used: 0,
+            budget: None,
+            interval: u32::MAX,
+            poll: None,
+            stopped: None,
+        }
+    }
+
+    /// A meter for `limits`.
+    #[cfg(feature = "utf16")]
+    fn new(limits: &'a mut Limits<'_>) -> Self {
+        let interval = limits.poll_interval.max(1);
+        let mut m = Meter {
+            fuel: 0,
+            chunk: 0,
+            used: 0,
+            budget: limits.budget,
+            interval,
+            poll: Some(&mut *limits.poll),
+            stopped: None,
+        };
+        m.chunk = m.next_chunk();
+        m.fuel = m.chunk;
+        m
+    }
+
+    /// The size of the next chunk: the poll interval, or less when the budget ends sooner.
+    fn next_chunk(&self) -> u32 {
+        match self.budget {
+            Some(b) => {
+                let left = b.saturating_sub(self.used);
+                core::cmp::min(u64::from(self.interval), left) as u32
+            }
+            None => self.interval,
+        }
+    }
+
+    /// Counts one step. \return false if the search must stop.
+    #[inline(always)]
+    fn step(&mut self) -> bool {
+        if self.fuel == 0 {
+            return self.refuel();
+        }
+        self.fuel -= 1;
+        true
+    }
+
+    /// The chunk ran out: count it, check the budget, poll, and start the next chunk.
+    #[cold]
+    #[inline(never)]
+    fn refuel(&mut self) -> bool {
+        if self.stopped.is_some() {
+            return false;
+        }
+        self.used = self.used.saturating_add(u64::from(self.chunk));
+        if self.budget.is_some_and(|b| self.used >= b) {
+            self.stopped = Some(Stopped::BudgetExceeded);
+            return false;
+        }
+        if let Some(poll) = self.poll.as_mut() {
+            if poll() {
+                self.stopped = Some(Stopped::Interrupted);
+                return false;
+            }
+        }
+        // This step is the first of the new chunk.
+        self.chunk = self.next_chunk();
+        self.fuel = self.chunk.saturating_sub(1);
+        true
+    }
+}
