--- /dev/null
+++ b/tests/limits.rs
@@ -0,0 +1,210 @@
+//! Searches with `Limits`: the step budget and the interrupt poll (`Regex::find_limited`).
+#![cfg(feature = "utf16")]
+
+use regress::{Flags, Limits, Regex, Stopped, Text};
+
+fn utf16(s: &str) -> Vec<u16> {
+    s.encode_utf16().collect()
+}
+
+/// `find_limited` with no budget and a poll that never stops: the same match as
+/// `find_from_utf16` / `find_from_ucs2`.
+#[test]
+fn unlimited_search_finds_the_same_match() {
+    let cases = [
+        ("a+b", "", "xxaaab"),
+        ("(a)|(b)", "", "zzb"),
+        ("(?<=x)y", "", "xyxy"),
+        ("(?=(a+))a*b", "", "aaab"),
+        ("\\u{1F600}+", "u", "x\u{1F600}\u{1F600}"),
+        ("^$", "m", "a\n\nb"),
+        ("q", "", "abc"),
+    ];
+    for (pattern, flags, text) in cases {
+        let re = Regex::with_flags(pattern, flags).unwrap();
+        let units = utf16(text);
+        for start in 0..=units.len() + 1 {
+            let mut never = || false;
+            let mut limits = Limits {
+                budget: None,
+                poll_interval: 3,
+                poll: &mut never,
+            };
+            let (text, want) = if re_is_unicode(flags) {
+                (
+                    Text::Utf16(&units),
+                    re.find_from_utf16(&units, start).next(),
+                )
+            } else {
+                (Text::Ucs2(&units), re.find_from_ucs2(&units, start).next())
+            };
+            let got = re.find_limited(text, start, &mut limits).unwrap();
+            assert_eq!(
+                got.as_ref()
+                    .map(|m| (m.range(), m.groups().collect::<Vec<_>>())),
+                want.as_ref()
+                    .map(|m| (m.range(), m.groups().collect::<Vec<_>>())),
+                "/{pattern}/{flags} on {text:?} from {start}"
+            );
+        }
+    }
+}
+
+fn re_is_unicode(flags: &str) -> bool {
+    flags.contains('u') || flags.contains('v')
+}
+
+/// A catastrophic pattern stops at the first poll that returns true.
+#[test]
+fn a_poll_interrupts_exponential_backtracking() {
+    let re = Regex::with_flags("(a+)+b", Flags::default()).unwrap();
+    let text = utf16(&"a".repeat(30));
+    let mut polls = 0u32;
+    let mut stop_at_third = || {
+        polls += 1;
+        polls == 3
+    };
+    let mut limits = Limits {
+        budget: None,
+        poll_interval: 1000,
+        poll: &mut stop_at_third,
+    };
+    let r = re.find_limited(Text::Ucs2(&text), 0, &mut limits);
+    assert_eq!(r.unwrap_err(), Stopped::Interrupted);
+    assert_eq!(polls, 3);
+}
+
+/// The budget ends the search with `BudgetExceeded`; a search inside the budget is not
+/// changed by it.
+#[test]
+fn the_budget_ends_a_long_search() {
+    let re = Regex::new("(a+)+b").unwrap();
+    let text = utf16(&"a".repeat(30));
+    let mut never = || false;
+    let mut limits = Limits {
+        budget: Some(100_000),
+        poll_interval: 1024,
+        poll: &mut never,
+    };
+    let r = re.find_limited(Text::Ucs2(&text), 0, &mut limits);
+    assert_eq!(r.unwrap_err(), Stopped::BudgetExceeded);
+
+    let mut text = text;
+    text.push(u16::from(b'b'));
+    let mut never = || false;
+    let mut limits = Limits {
+        budget: Some(100_000),
+        poll_interval: 1024,
+        poll: &mut never,
+    };
+    let m = re.find_limited(Text::Ucs2(&text), 0, &mut limits).unwrap();
+    assert_eq!(m.unwrap().range(), 0..31);
+
+    // A budget of 0 stops at the first step.
+    let mut never = || false;
+    let mut limits = Limits {
+        budget: Some(0),
+        poll_interval: 1024,
+        poll: &mut never,
+    };
+    let r = re.find_limited(Text::Ucs2(&text), 0, &mut limits);
+    assert_eq!(r.unwrap_err(), Stopped::BudgetExceeded);
+}
+
+/// A stop inside a negative lookahead stops the whole search (it is not a failed
+/// lookahead, which would make the negation succeed).
+#[test]
+fn a_stop_inside_a_lookaround_stops_the_search() {
+    for pattern in ["(?!(a+)+b)", "(?=(a+)+b)|c", "(?<!b(a+)+)z"] {
+        let re = Regex::new(pattern).unwrap();
+        let text = utf16(&format!("{}z", "a".repeat(28)));
+        let mut polls = 0u32;
+        let mut stop_at_second = || {
+            polls += 1;
+            polls == 2
+        };
+        let mut limits = Limits {
+            budget: None,
+            poll_interval: 500,
+            poll: &mut stop_at_second,
+        };
+        let r = re.find_limited(Text::Ucs2(&text), 0, &mut limits);
+        assert_eq!(r.unwrap_err(), Stopped::Interrupted, "{pattern}");
+    }
+}
+
+/// Start positions count as steps, so a long search with no backtracking polls too. (Every
+/// position can start a match of the pattern, so no start predicate skips one.)
+#[test]
+fn start_positions_are_steps() {
+    let re = Regex::new("a(?=b)").unwrap();
+    let text = vec![u16::from(b'a'); 100_000];
+    let mut polls = 0u32;
+    let mut count = || {
+        polls += 1;
+        false
+    };
+    let mut limits = Limits {
+        budget: None,
+        poll_interval: 1000,
+        poll: &mut count,
+    };
+    assert!(
+        re.find_limited(Text::Ucs2(&text), 0, &mut limits)
+            .unwrap()
+            .is_none()
+    );
+    assert!(polls >= 99, "{polls} polls");
+}
+
+/// A start past the end finds nothing and takes no step.
+#[test]
+fn a_start_past_the_end_finds_nothing() {
+    let re = Regex::new("").unwrap();
+    let text = utf16("ab");
+    let mut calls = 0;
+    let mut count = || {
+        calls += 1;
+        true
+    };
+    let mut limits = Limits {
+        budget: Some(0),
+        poll_interval: 1,
+        poll: &mut count,
+    };
+    assert!(
+        re.find_limited(Text::Ucs2(&text), 3, &mut limits)
+            .unwrap()
+            .is_none()
+    );
+    assert_eq!(calls, 0);
+}
+
+/// Each iteration of a single-character loop (`Loop1CharBody`: greedy, lazy, counted, and
+/// inside a lookaround) is a step, like an iteration of any other loop: a long run of one
+/// character spends the budget and polls.
+#[test]
+fn single_character_loop_iterations_are_steps() {
+    let text = vec![u16::from(b'a'); 100_000];
+    for pattern in ["a+", "a{99999}", "a+?$", "(?=a*)(?:b|$)", "(?<=a*)$"] {
+        let re = Regex::new(pattern).unwrap();
+        let mut never = || false;
+        let mut limits = Limits {
+            budget: Some(10_000),
+            poll_interval: 1024,
+            poll: &mut never,
+        };
+        let r = re.find_limited(Text::Ucs2(&text), 0, &mut limits);
+        assert_eq!(r.unwrap_err(), Stopped::BudgetExceeded, "/{pattern}/");
+    }
+    // Within the budget the match is the same.
+    let re = Regex::new("a+").unwrap();
+    let mut never = || false;
+    let mut limits = Limits {
+        budget: Some(200_000),
+        poll_interval: 1024,
+        poll: &mut never,
+    };
+    let m = re.find_limited(Text::Ucs2(&text), 0, &mut limits).unwrap();
+    assert_eq!(m.unwrap().range(), 0..100_000);
+}
