+        // The limits stopped the search inside the lookaround: fail, so the caller backtracks
+        // out of the whole search.
+        if self.meter.stopped.is_some() {
+            self.s.groups.splice(range, saved_groups);
+            return false;
+        }
+
         // If we are a positive lookahead that successfully matched, retain the
         // capture groups (but we need to set up backtracking). Otherwise restore
         // them.
@@ -499,6 +697,11 @@ impl<'a, Input: InputIndexer> MatchAttempter<'a, Input> {
         pos: &mut Input::Position,
         _dir: Dir,
     ) -> bool {
+        if !self.meter.step() {
+            // Stopped: give up the whole search.
+            self.bts.truncate(1);
+            return false;
+        }
         loop {
             // We always have a single Exhausted instruction backstopping our stack,
             // so we do not need to check for empty bts.
@@ -1071,6 +1274,9 @@ impl<Input: InputIndexer> BacktrackExecutor<'_, Input> {
     ) -> Option<Match> {
         let inp = self.input;
         loop {
+            if !self.matcher.step() {
+                return None;
+            }
             // Find the next start location, or None if none.
             // Don't try this unless CODE_UNITS_ARE_BYTES - i.e. don't do byte searches
             // on UTF-16 or UCS2.
@@ -1133,6 +1339,30 @@ impl<Input: InputIndexer> exec::MatchProducer for BacktrackExecutor<'_, Input> {
     }
 }
 
+/// The first match of `re` in `input` from code unit `start`, with the steps of the search
+/// counted against `limits` (`Regex::find_limited`).
+#[cfg(feature = "utf16")]
+pub(crate) fn find_limited<Input: InputIndexer>(
+    re: &CompiledRegex,
+    input: Input,
+    start: usize,
+    limits: &mut Limits<'_>,
+) -> Result<Option<Match>, Stopped> {
+    let Some(pos) = input.try_move_right(input.left_end(), start) else {
+        return Ok(None);
+    };
+    let mut exec = BacktrackExecutor::new(
+        input,
+        MatchAttempter::with_limits(re, input.left_end(), limits),
+    );
+    let mut next_start = None;
+    let found = exec::MatchProducer::next_match(&mut exec, pos, &mut next_start);
+    match exec.matcher.stopped() {
+        Some(why) => Err(why),
+        None => Ok(found),
+    }
+}
+
 impl<'r, 't> exec::Executor<'r, 't> for BacktrackExecutor<'r, Utf8Input<'t>> {
     type AsAscii = BacktrackExecutor<'r, AsciiInput<'t>>;
 
