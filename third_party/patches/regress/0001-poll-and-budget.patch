+/// How a search with [`Limits`] ended before it had its answer.
+#[derive(Debug, Copy, Clone, PartialEq, Eq)]
+pub enum Stopped {
+    /// The `poll` callback of the [`Limits`] returned true.
+    Interrupted,
+    /// The search took more steps than the budget of the [`Limits`].
+    BudgetExceeded,
+}
+
+/// Limits of one search: a step budget and an interrupt poll.
+///
+/// A step is one start position, one backtrack or one loop iteration of the backtracking
+/// engine, so a search with no backtracks counts at most one step per input position and
+/// loop iteration. Every `poll_interval` steps the search calls `poll`; when it returns true
+/// the search ends with [`Stopped::Interrupted`]. When the steps reach `budget` the search ends
+/// with [`Stopped::BudgetExceeded`] (the budget is checked when a poll interval ends, so a
+/// search may take up to `poll_interval - 1` more steps).
+pub struct Limits<'p> {
+    /// The most steps one search may take; `None` means no limit.
+    pub budget: Option<u64>,
+    /// The steps between two calls of `poll` (0 counts as 1).
+    pub poll_interval: u32,
+    /// Called every `poll_interval` steps; `true` stops the search.
+    pub poll: &'p mut dyn FnMut() -> bool,
+}
+
+impl fmt::Debug for Limits<'_> {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("Limits")
+            .field("budget", &self.budget)
+            .field("poll_interval", &self.poll_interval)
+            .finish_non_exhaustive()
+    }
+}
+
+/// A string of UTF-16 code units, the subject of a [`Regex::find_limited`] search. Positions
