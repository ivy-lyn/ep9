     let mut res = vec![c];
-    let fcp = uppercase(c);
-    if fcp != c {
-        res.push(fcp);
+    let canon = canonicalize_legacy(c);
+    if canon != c && canonicalize_legacy(canon) == canon {
+        res.push(canon);
     }
+    // Any other `cp` with that canonical value has `uppercase(cp) == canon`: it is in a
+    // range of the table that maps to `canon`.
     for tr in TO_UPPERCASE.iter() {
-        if !tr.transformed_to().contains(fcp) {
+        if !tr.transformed_to().contains(canon) {
             continue;
         }
         for cp in tr.transformed_from().codepoints() {
-            let tcp = tr.apply(cp);
-            if tcp == fcp {
+            if tr.apply(cp) == canon && canonicalize_legacy(cp) == canon {
                 res.push(cp);
             }
         }
