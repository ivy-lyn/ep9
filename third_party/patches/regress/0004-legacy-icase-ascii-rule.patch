+/// The code points that match `cps` case-insensitively: closed under simple case folding
+/// with the `u` or `v` flag, else under the legacy Canonicalize (its ASCII rule).
+fn add_icase_code_points(cps: CodePointSet, unicode: bool) -> CodePointSet {
+    if unicode {
