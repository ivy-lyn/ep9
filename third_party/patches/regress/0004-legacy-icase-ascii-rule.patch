+//! Case-insensitive matching without the `u` and `v` flags: the JavaScript Canonicalize
+//! (ECMA-262 §22.2.2.7.3) uppercases a character, but keeps it when its uppercase is not one
+//! code unit, or when a character at or above 128 would become ASCII. So `ſ` (U+017F), `ı`
+//! (U+0131) and the Kelvin sign (U+212A) do not match ASCII letters. With `u` or `v` simple
+//! case folding applies. Expected results: node v24.22.0.
+#![cfg(feature = "utf16")]
+
+use regress::Regex;
+
+/// Whether `pattern` with `flags` matches somewhere in the UTF-16 text `text`.
+fn matches(pattern: &str, flags: &str, text: &str) -> bool {
+    let re = Regex::with_flags(pattern, flags).unwrap();
+    let units: Vec<u16> = text.encode_utf16().collect();
+    if flags.contains('u') {
+        re.find_from_utf16(&units, 0).next().is_some()
+    } else {
+        re.find_from_ucs2(&units, 0).next().is_some()
+    }
+}
+
+#[test]
+fn non_ascii_never_matches_ascii() {
+    // (pattern, text, node's result without u)
+    let cases = [
+        ("\\w", "\u{17f}", false),
+        ("\\w", "\u{212a}", false),
+        ("\\W", "\u{17f}", true),
+        ("\\W", "\u{212a}", true),
+        ("[\\w]", "\u{17f}", false),
+        ("[^\\W]", "\u{212a}", false),
+        ("\\u017f", "s", false),
+        ("\\u017f", "S", false),
+        ("\\u017f", "\u{17f}", true),
+        ("s", "\u{17f}", false),
+        ("\\u0131", "I", false),
+        ("i", "\u{131}", false),
+        ("[a-z]", "\u{212a}", false),
+        ("[a-z]", "\u{17f}", false),
+        ("[^a-z]", "\u{17f}", true),
+        ("k", "\u{212a}", false),
+        (
+            "[\\u00c0-\\u024f]",
+            "The quick brown fox jumps over the lazy dog 1234",
+            false,
+        ),
+        ("(s)\\1", "s\u{17f}", false),
+        ("(s)\\1", "sS", true),
+        ("(\u{17f})\\1", "\u{17f}s", false),
+    ];
+    for (p, t, want) in cases {
+        assert_eq!(matches(p, "i", t), want, "/{p}/i on {t:?}");
+    }
+}
+
+#[test]
+fn uppercase_of_more_than_one_unit_keeps_the_character() {
+    let cases = [
+        ("\\u1f80", "\u{1f88}", false),
+        ("\\u1f88", "\u{1f80}", false),
+        ("\\u1f80", "\u{1f80}", true),
+        ("\\u00df", "\u{1e9e}", false),
+        ("\\u00df", "SS", false),
+        ("[\\u1f80-\\u1f87]", "\u{1f8a}", false),
+        ("(\\u1fb3)\\1", "\u{1fb3}\u{1fbc}", false),
+    ];
+    for (p, t, want) in cases {
+        assert_eq!(matches(p, "i", t), want, "/{p}/i on {t:?}");
+    }
+}
+
+#[test]
+fn other_case_pairs_still_match() {
+    let cases = [
+        ("\\u00e9", "\u{c9}", true),
+        ("\\u00b5", "\u{39c}", true),
+        ("\\u00b5", "\u{3bc}", true),
+        ("[\\u03bc]", "\u{b5}", true),
+        ("[a-z]+", "ABC", true),
+        ("(\\u00e9)\\1", "\u{e9}\u{c9}", true),
+        ("\\u01c5", "\u{1c4}", true),
+        ("\\u01c6", "\u{1c5}", true),
+    ];
+    for (p, t, want) in cases {
+        assert_eq!(matches(p, "i", t), want, "/{p}/i on {t:?}");
+    }
+}
+
+#[test]
+fn unicode_mode_uses_simple_case_folding() {
+    let cases = [
+        ("\\u017f", "s", true),
+        ("\\w", "\u{17f}", true),
+        ("\\W", "\u{17f}", false),
+        ("[a-z]", "\u{212a}", true),
+        ("(s)\\1", "s\u{17f}", true),
+        ("\\u1f80", "\u{1f88}", true),
+    ];
+    for (p, t, want) in cases {
+        assert_eq!(matches(p, "iu", t), want, "/{p}/iu on {t:?}");
+    }
+}
