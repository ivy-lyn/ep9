+/// The BMP code points whose full uppercase mapping (`toUppercase`, with the unconditional
+/// mappings of SpecialCasing.txt, Unicode 17.0) is not a single UTF-16 code unit. Sorted.
+const UPPERCASE_NOT_ONE_UNIT: [u16; 102] = [
+    0x00DF, 0x0149, 0x01F0, 0x0390, 0x03B0, 0x0587, 0x1E96, 0x1E97, 0x1E98, 0x1E99, 0x1E9A, 0x1F50,
