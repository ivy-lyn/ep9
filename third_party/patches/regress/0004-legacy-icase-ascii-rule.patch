+    0x1FA1, 0x1FA2, 0x1FA3, 0x1FA4, 0x1FA5, 0x1FA6, 0x1FA7, 0x1FA8, 0x1FA9, 0x1FAA, 0x1FAB, 0x1FAC,
+    0x1FAD, 0x1FAE, 0x1FAF, 0x1FB2, 0x1FB3, 0x1FB4, 0x1FB6, 0x1FB7, 0x1FBC, 0x1FC2, 0x1FC3, 0x1FC4,
+    0x1FC6, 0x1FC7, 0x1FCC, 0x1FD2, 0x1FD3, 0x1FD6, 0x1FD7, 0x1FE2, 0x1FE3, 0x1FE4, 0x1FE6, 0x1FE7,
+    0x1FF2, 0x1FF3, 0x1FF4, 0x1FF6, 0x1FF7, 0x1FFC, 0xFB00, 0xFB01, 0xFB02, 0xFB03, 0xFB04, 0xFB05,
+    0xFB06, 0xFB13, 0xFB14, 0xFB15, 0xFB16, 0xFB17,
+];
+
+/// `Canonicalize` without the `u` and `v` flags ([spec] step 3 on): the uppercase of `cu`,
+/// except that `cu` stays itself when its full uppercase is not one code unit (`ß` -> "SS")
+/// and when a character at or above 128 would become ASCII (`ſ` U+017F -> `S`, `ı` U+0131 ->
+/// `I`), so that a non-ASCII character never matches an ASCII one.
+///
+/// [spec]: https://tc39.es/ecma262/#sec-runtime-semantics-canonicalize-ch
+pub(crate) fn canonicalize_legacy(cu: u32) -> u32 {
+    let upper = uppercase(cu);
+    if upper == cu {
+        return cu;
+    }
+    if cu >= 128 && upper < 128 {
+        return cu;
+    }
+    if let Ok(unit) = u16::try_from(cu) {
+        if UPPERCASE_NOT_ONE_UNIT.binary_search(&unit).is_ok() {
+            return cu;
+        }
+    }
+    upper
+}
+
+/// Calls `f(cp, canonicalize_legacy(cp))` for every code point that `canonicalize_legacy`
+/// changes (they are all in the TO_UPPERCASE table).
+fn for_each_legacy_canonicalization(mut f: impl FnMut(u32, u32)) {
+    for tr in TO_UPPERCASE.iter() {
+        let modulo = tr.predicate_mask() + 1;
+        let mut cp = tr.first();
+        while cp <= tr.last() {
+            let canon = canonicalize_legacy(cp);
+            if canon != cp {
+                f(cp, canon);
+            }
+            cp += modulo;
+        }
+    }
+}
+
+/// The code points that match the code points of `input` without the `u` and `v` flags:
+/// every `ch` such that `canonicalize_legacy(ch)` is `canonicalize_legacy(c)` of some `c` in
+/// `input` (CharacterSetMatcher with `rer.[[IgnoreCase]]`).
+pub fn add_icase_code_points_legacy(input: CodePointSet) -> CodePointSet {
+    // The canonical values of the members that `canonicalize_legacy` changes. The others
+    // are their own canonical value, so `input` holds them.
+    let mut targets = CodePointSet::new();
+    for_each_legacy_canonicalization(|cp, canon| {
+        if input.contains(cp) {
+            targets.add_one(canon);
+        }
+    });
+    let is_canonical_value =
+        |v: u32| targets.contains(v) || (input.contains(v) && canonicalize_legacy(v) == v);
+    let mut result = input.clone();
+    for iv in targets.intervals() {
+        for v in iv.codepoints() {
+            if canonicalize_legacy(v) == v {
+                result.add_one(v);
+            }
+        }
+    }
+    for_each_legacy_canonicalization(|cp, canon| {
+        if is_canonical_value(canon) {
+            result.add_one(cp);
+        }
+    });
+    result
 }
 
 pub fn fold(cu: u32) -> u32 {
@@ -300,19 +382,22 @@ pub fn unfold_char(c: u32) -> Vec<u32> {
     res
 }
 
