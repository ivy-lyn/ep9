+/// A Latin-1 string: one byte per code unit, each code unit is one character (code points
+/// 0 to 255). A UTF-16 string whose code units all fit in a byte can be searched in this form
+/// with no copy. Matching is as for UCS-2 and UTF-16 (a Latin-1 string has no surrogates);
+/// the code units are bytes, so the byte searchers of the start predicates work.
+#[cfg(feature = "utf16")]
+#[derive(Debug, Copy, Clone)]
+pub struct Latin1Input<'a> {
+    input: &'a [u8],
+    unicode: bool,
+}
+
+#[cfg(feature = "utf16")]
+impl<'a> Latin1Input<'a> {
+    pub fn new(s: &'a [u8], unicode: bool) -> Self {
+        Self { input: s, unicode }
+    }
+
+    #[inline(always)]
+    fn debug_assert_valid_pos(&self, pos: <Self as InputIndexer>::Position) -> &Self {
+        debug_assert!(self.left_end() <= pos && pos <= self.right_end());
+        self
+    }
+}
+
+#[cfg(feature = "utf16")]
+impl<'a> InputIndexer for Latin1Input<'a> {
+    type Position = IndexPosition<'a>;
+    type Element = u32;
+    type CharProps = matchers::Utf16CharProperties;
+    const CODE_UNITS_ARE_BYTES: bool = true;
+    const UNIT_PREDICATES: bool = true;
+
+    fn find_unit_start(&self, pos: Self::Position, pred: &UnitPredicate) -> Option<Self::Position> {
+        let rest = &self.input[self.pos_to_offset(pos)..];
+        let at = match pred {
+            UnitPredicate::Prefix { finder, .. } => finder.find(rest)?,
+            UnitPredicate::First(set) => match set.few {
+                Some([a, b, c]) => memchr::memchr3(a, b, c, rest)?,
+                None => bytesearch::ByteSearcher::find_in(&set.low, rest)?,
+            },
+            UnitPredicate::Arbitrary | UnitPredicate::StartAnchored => 0,
+        };
+        Some(pos + at)
+    }
+
+    #[inline(always)]
+    fn unicode(&self) -> bool {
+        self.unicode
+    }
+
+    #[inline(always)]
+    fn subinput(&self, range: ops::Range<Self::Position>) -> Latin1Input<'a> {
+        self.debug_assert_valid_pos(range.start);
+        self.debug_assert_valid_pos(range.end);
+        debug_assert!(range.end >= range.start);
+        Latin1Input {
+            input: &self.input[core::ops::Range {
+                start: self.pos_to_offset(range.start),
+                end: self.pos_to_offset(range.end),
+            }],
+            unicode: self.unicode(),
+        }
+    }
+
+    #[inline(always)]
+    fn next_right(&self, pos: &mut Self::Position) -> Option<Self::Element> {
+        let b = self.input.get(self.pos_to_offset(*pos)).copied()?;
+        *pos += 1;
+        Some(b.into())
+    }
+
+    #[inline(always)]
+    fn next_left(&self, pos: &mut Self::Position) -> Option<Self::Element> {
+        if *pos == self.left_end() {
+            return None;
+        }
+        let b = self.input.get(self.pos_to_offset(*pos - 1)).copied()?;
+        *pos -= 1;
+        Some(b.into())
+    }
+
+    #[inline(always)]
+    fn next_right_pos(&self, pos: Self::Position) -> Option<Self::Position> {
+        self.try_move_right(pos, 1)
+    }
+
+    #[inline(always)]
+    fn next_left_pos(&self, pos: Self::Position) -> Option<Self::Position> {
+        self.try_move_left(pos, 1)
+    }
+
+    #[inline(always)]
+    fn peek_byte_right(&self, pos: Self::Position) -> Option<u8> {
+        self.input.get(self.pos_to_offset(pos)).copied()
+    }
+
+    #[inline(always)]
+    fn peek_byte_left(&self, pos: Self::Position) -> Option<u8> {
+        if pos == self.left_end() {
+            return None;
+        }
+        self.input.get(self.pos_to_offset(pos - 1)).copied()
+    }
+
+    #[inline(always)]
+    fn left_end(&self) -> Self::Position {
+        Self::Position::new(0)
+    }
+
+    #[inline(always)]
+    fn right_end(&self) -> Self::Position {
+        Self::Position::new(self.input.len())
+    }
+
+    #[inline(always)]
+    fn pos_to_offset(&self, pos: Self::Position) -> usize {
+        debug_assert!(self.left_end() <= pos && pos <= self.right_end());
+        pos - self.left_end()
+    }
+
+    fn try_move_right(&self, mut pos: Self::Position, amt: usize) -> Option<Self::Position> {
+        self.debug_assert_valid_pos(pos);
+        if self.right_end() - pos < amt {
+            None
+        } else {
+            pos += amt;
+            self.debug_assert_valid_pos(pos);
+            Some(pos)
+        }
+    }
+
+    #[inline(always)]
+    fn try_move_left(&self, mut pos: Self::Position, amt: usize) -> Option<Self::Position> {
+        self.debug_assert_valid_pos(pos);
+        if pos - self.left_end() < amt {
+            None
+        } else {
+            pos -= amt;
+            self.debug_assert_valid_pos(pos);
+            Some(pos)
+        }
+    }
+
+    #[inline(always)]
+    fn find_bytes<Search: bytesearch::ByteSearcher>(
+        &self,
+        pos: Self::Position,
+        search: &Search,
+    ) -> Option<Self::Position> {
+        let rem = &self.input[self.pos_to_offset(pos)..];
+        let idx = search.find_in(rem)?;
+        Some(pos + idx)
+    }
+
+    fn subrange_eq<Dir: Direction>(
+        &self,
+        _dir: Dir,
+        pos: &mut Self::Position,
+        range: Range<Self::Position>,
+    ) -> bool {
+        let len = range.end - range.start;
+        let (start, end) = if Dir::FORWARD {
+            if let Some(end) = self.try_move_right(*pos, len) {
+                let start = *pos;
+                *pos = end;
+                (start, end)
+            } else {
+                return false;
+            }
+        } else if let Some(start) = self.try_move_left(*pos, len) {
+            let end = *pos;
+            *pos = start;
+            (start, end)
+        } else {
+            return false;
+        };
+
+        let new_range = &self.input[self.pos_to_offset(start)..self.pos_to_offset(end)];
+        let old_range = &self.input[self.pos_to_offset(range.start)..self.pos_to_offset(range.end)];
+
+        new_range == old_range
+    }
+
+    fn match_bytes<const N: usize, Dir: Direction>(
+        &self,
+        dir: Dir,
+        pos: &mut Self::Position,
+        bytes: &[u8; N],
+    ) -> bool {
+        let (start, end) = if Dir::FORWARD {
+            match self.try_move_right(*pos, N) {
+                Some(end) => (*pos, end),
+                None => return false,
+            }
+        } else {
+            match self.try_move_left(*pos, N) {
+                Some(start) => (start, *pos),
+                None => return false,
+            }
+        };
+        let _ = dir;
+        if &self.input[self.pos_to_offset(start)..self.pos_to_offset(end)] != bytes {
+            return false;
+        }
+        *pos = if Dir::FORWARD { end } else { start };
+        true
+    }
+}
+
+/// The most prefix units `find_unit_start_u16` compares at one candidate position. The
+/// search does not count its steps, so its work must stay linear in the text: a longer
+/// prefix is checked by the (counted) match attempt at the position it returns.
+#[cfg(feature = "utf16")]
+const PREFIX_CHECK_UNITS: usize = 16;
+
+/// The index in `units` of the first code unit where a match may start under `pred` (a
+/// `Prefix` or `First` predicate), or None. It compares at most `PREFIX_CHECK_UNITS` units
+/// of the prefix at each candidate, so a search takes O(text length) work.
+#[cfg(feature = "utf16")]
+fn find_unit_start_u16(units: &[u16], pred: &UnitPredicate) -> Option<usize> {
+    match pred {
+        UnitPredicate::Prefix { units: prefix, .. } => {
+            let first = u16::from(prefix[0]);
+            let check = &prefix[..core::cmp::min(prefix.len(), PREFIX_CHECK_UNITS)];
+            let mut at = 0;
+            loop {
+                at += units[at..].iter().position(|&u| u == first)?;
+                let rest = &units[at..];
+                if rest.len() >= prefix.len()
+                    && rest
+                        .iter()
+                        .zip(check.iter())
+                        .all(|(&u, &p)| u == u16::from(p))
+                {
+                    return Some(at);
+                }
+                if rest.len() < prefix.len() {
+                    return None;
+                }
+                at += 1;
+            }
+        }
+        UnitPredicate::First(set) => units.iter().position(|&u| set.contains(u)),
+        UnitPredicate::Arbitrary | UnitPredicate::StartAnchored => Some(0),
+    }
+}
