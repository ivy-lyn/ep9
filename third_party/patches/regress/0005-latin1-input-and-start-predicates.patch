+/// The start predicate of a search over UTF-16 code units (UTF-16, UCS-2 or Latin-1 text):
+/// a fast way to skip positions where no match can start.
+#[cfg(feature = "utf16")]
+#[derive(Debug, Clone)]
+pub enum UnitPredicate {
+    /// No predicate: try every position.
+    Arbitrary,
+
+    /// The regex is anchored to the start of the input: try only the first position.
+    StartAnchored,
+
+    /// Every match starts with these code units (two or more, each below 256).
+    Prefix {
+        units: Box<[u8]>,
+        finder: Box<memmem::Finder<'static>>,
+    },
+
+    /// The first code unit of every match is in this set.
+    First(UnitSet),
+}
+
+/// A set of code units: those below 256 in a bitmap, and whether any unit at or above 256
+/// is in the set.
+#[cfg(feature = "utf16")]
+#[derive(Debug, Clone)]
+pub struct UnitSet {
+    /// The members below 256.
+    pub low: ByteBitmap,
+    /// True if every unit at or above 256 is a member.
+    pub high: bool,
+    /// When `low` has 1 to 3 members and `high` is false: the members (repeated to fill the
+    /// array), for a memchr search of Latin-1 text.
+    pub few: Option<[u8; 3]>,
+}
+
+#[cfg(feature = "utf16")]
+impl UnitSet {
+    /// \return whether the code unit `u` is in the set.
+    #[inline(always)]
+    pub fn contains(&self, u: u16) -> bool {
+        match u8::try_from(u) {
+            Ok(b) => self.low.contains(b),
+            Err(_) => self.high,
+        }
+    }
+}
