+
+/// The code-unit form of a start predicate (a search over UTF-16, UCS-2 or Latin-1 text).
+#[cfg(feature = "utf16")]
+enum AbstractUnitPredicate {
+    /// No predicate.
+    Arbitrary,
+
+    /// A match starts with these code units (one or more, each below 0x10000).
+    Sequence(Vec<u32>),
+
+    /// The first code unit of a match: below 256 in `low`, any other if `high`.
+    Set { low: Box<ByteBitmap>, high: bool },
+}
+
+#[cfg(feature = "utf16")]
+impl AbstractUnitPredicate {
+    /// The empty set (no code unit starts a match).
+    fn empty_set() -> Self {
+        Self::Set {
+            low: Box::default(),
+            high: false,
+        }
+    }
+
+    /// Adds the code unit `u` to a set.
+    fn add_unit(low: &mut ByteBitmap, high: &mut bool, u: u32) {
+        match u8::try_from(u) {
+            Ok(b) => low.set(b),
+            Err(_) => *high = true,
+        }
+    }
+
+    /// The set of the first code units of the characters in `chars` (a supplementary
+    /// character starts with a lead surrogate, at or above 256).
+    fn first_units_of(chars: impl Iterator<Item = u32>) -> Self {
+        let mut low = Box::<ByteBitmap>::default();
+        let mut high = false;
+        for c in chars {
+            Self::add_unit(&mut low, &mut high, c);
+        }
+        Self::Set { low, high }
+    }
+
+    /// \return the disjunction of two predicates.
+    fn disjunction(x: Self, y: Self) -> Self {
+        match (x, y) {
+            (Self::Arbitrary, _) | (_, Self::Arbitrary) => Self::Arbitrary,
+            (Self::Sequence(s1), Self::Sequence(s2)) => {
+                let shared = s1.iter().zip(s2.iter()).take_while(|(a, b)| a == b).count();
+                if shared > 0 {
+                    Self::Sequence(s1[..shared].to_vec())
+                } else {
+                    Self::first_units_of([s1[0], s2[0]].into_iter())
+                }
+            }
+            (
+                Self::Set {
+                    low: mut l1,
+                    high: h1,
+                },
+                Self::Set { low: l2, high: h2 },
+            ) => {
+                l1.bitor(&l2);
+                Self::Set {
+                    low: l1,
+                    high: h1 || h2,
+                }
+            }
+            (Self::Set { mut low, mut high }, Self::Sequence(s))
+            | (Self::Sequence(s), Self::Set { mut low, mut high }) => {
+                Self::add_unit(&mut low, &mut high, s[0]);
+                Self::Set { low, high }
+            }
+        }
+    }
+
+    fn resolve(self) -> UnitPredicate {
+        match self {
+            Self::Arbitrary => UnitPredicate::Arbitrary,
+            Self::Sequence(units) => {
+                let bytes: Vec<u8> = units.iter().map_while(|&u| u8::try_from(u).ok()).collect();
+                if bytes.len() >= 2 {
+                    UnitPredicate::Prefix {
+                        finder: Box::new(memmem::Finder::new(&bytes).into_owned()),
+                        units: bytes.into_boxed_slice(),
+                    }
+                } else {
+                    Self::first_units_of(units[..1].iter().copied()).resolve()
+                }
+            }
+            Self::Set { low, high } => {
+                let few = if high || low.count_bits() == 0 || low.count_bits() > 3 {
+                    None
+                } else {
+                    let members: Vec<u8> = (0..=255u8).filter(|&b| low.contains(b)).collect();
+                    let last = members[members.len() - 1];
+                    Some([
+                        members[0],
+                        *members.get(1).unwrap_or(&last),
+                        *members.get(2).unwrap_or(&last),
+                    ])
+                };
+                UnitPredicate::First(UnitSet {
+                    low: *low,
+                    high,
+                    few,
+                })
+            }
+        }
+    }
+}
+
+/// Compute the code-unit start predicate of a node. As `compute_start_predicate`: `None`
+/// for a zero-width node, `Arbitrary` for no predicate. Icase nodes are already expanded
+/// into their sets by the parser.
+#[cfg(feature = "utf16")]
+fn compute_unit_predicate(n: &Node) -> Option<AbstractUnitPredicate> {
+    use AbstractUnitPredicate as P;
+    let arbitrary = Some(P::Arbitrary);
+    match n {
+        &Node::Char { c } => {
+            if c < 0x1_0000 {
+                Some(P::Sequence(vec![c]))
+            } else {
+                Some(P::first_units_of(core::iter::once(c)))
+            }
+        }
+        Node::CharSet(chars) => Some(P::first_units_of(chars.iter().copied())),
+
+        // Bytes are UTF-8 bytes, which a code-unit search does not see.
+        Node::ByteSequence(..) | Node::ByteSet(..) => arbitrary,
+
+        Node::Empty | Node::Goal => arbitrary,
+        Node::BackRef { .. } | Node::BackRefAny { .. } => arbitrary,
+        Node::StringSet { .. } => arbitrary,
+        Node::MatchAny | Node::MatchAnyExceptLineTerminator => arbitrary,
+        Node::Anchor { .. } | Node::WordBoundary { .. } => arbitrary,
+
+        // A run of leading characters forms a sequence; else the first node that is not
+        // zero-width decides.
+        Node::Cat(nodes) => {
+            let mut seq = Vec::new();
+            for node in nodes {
+                if let &Node::Char { c } = node {
+                    if c < 0x1_0000 {
+                        seq.push(c);
+                        continue;
+                    }
+                }
+                if !seq.is_empty() {
+                    break;
+                }
+                if let Some(p) = compute_unit_predicate(node) {
+                    return Some(p);
+                }
+            }
+            if seq.is_empty() {
+                None
+            } else {
+                Some(P::Sequence(seq))
+            }
+        }
+
+        Node::CaptureGroup { contents, .. } => compute_unit_predicate(contents),
+        Node::LookaroundAssertion { .. } => None,
+
+        Node::Loop { loopee, quant, .. } | Node::Loop1CharBody { loopee, quant } => {
+            if quant.min > 0 {
+                compute_unit_predicate(loopee)
+            } else {
+                arbitrary
+            }
+        }
+
+        Node::Alt(left, right) => {
+            match (compute_unit_predicate(left), compute_unit_predicate(right)) {
+                (Some(x), Some(y)) => Some(P::disjunction(x, y)),
+                // One arm can match the empty string.
+                _ => arbitrary,
+            }
+        }
+
+        Node::Bracket(bc) => {
+            let storage;
+            let cps = if bc.invert {
+                storage = bc.cps.inverted();
+                &storage
+            } else {
+                &bc.cps
+            };
+            let P::Set { mut low, mut high } = P::empty_set() else {
+                unreachable!()
+            };
+            for iv in cps.intervals() {
+                for u in iv.first..=core::cmp::min(iv.last, 255) {
+                    low.set(u as u8);
+                }
+                if iv.last >= 256 {
+                    high = true;
+                }
+            }
+            Some(P::Set { low, high })
+        }
+    }
+}
+
+/// \return the code-unit start predicate of a regex (searches over UTF-16 code units).
+#[cfg(feature = "utf16")]
+pub fn unit_predicate_for_re(re: &ir::Regex) -> UnitPredicate {
+    if is_start_anchored(&re.node) && !re.flags.multiline {
+        return UnitPredicate::StartAnchored;
+    }
+    compute_unit_predicate(&re.node)
+        .unwrap_or(AbstractUnitPredicate::Arbitrary)
+        .resolve()
+}
