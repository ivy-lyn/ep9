@@ -0,0 +1,195 @@
+//! Latin-1 text (`Text::Latin1`, `find_from_latin1`) and the code-unit start predicates of a
+//! search over UTF-16, UCS-2 and Latin-1 text. The oracle is one match attempt at each
+//! position (`match_at_limited`), which uses no start predicate: the first position with a
+//! match is the answer of a search.
+#![cfg(feature = "utf16")]
+
+use regress::{Limits, Regex, Text};
+
+type Groups = Vec<Option<(usize, usize)>>;
+
+fn limits_run<T>(f: impl FnOnce(&mut Limits<'_>) -> T) -> T {
+    let mut never = || false;
+    let mut limits = Limits {
+        budget: None,
+        poll_interval: 4096,
+        poll: &mut never,
+    };
+    f(&mut limits)
+}
+
+fn groups(m: &regress::Match) -> Groups {
+    m.groups().map(|g| g.map(|r| (r.start, r.end))).collect()
+}
+
+/// The search result from `start` (predicates on).
+fn search(re: &Regex, text: Text<'_>, start: usize) -> Option<Groups> {
+    limits_run(|l| re.find_limited(text, start, l).unwrap()).map(|m| groups(&m))
+}
+
+/// The oracle: the first position from `start` where one attempt matches. In UTF-16
+/// (`unicode`) a search steps over a surrogate pair, so a position inside one is no start.
+fn oracle(
+    re: &Regex,
+    text: Text<'_>,
+    units: &[u16],
+    unicode: bool,
+    start: usize,
+) -> Option<Groups> {
+    let inside_pair = |p: usize| {
+        unicode
+            && p > start
+            && p < units.len()
+            && (0xdc00..0xe000).contains(&units[p])
+            && (0xd800..0xdc00).contains(&units[p - 1])
+    };
+    (start..=units.len())
+        .filter(|&p| !inside_pair(p))
+        .find_map(|p| limits_run(|l| re.match_at_limited(text, p, l).unwrap()).map(|m| groups(&m)))
+}
+
+const PATTERNS: &[&str] = &[
+    "abc",
+    "a|b",
+    "qqqq|qqq|qq",
+    "(?:ab)+c",
+    "[a-c]x",
+    "[^a]",
+    "\u{e9}+",
+    "\\u00e9",
+    "x*",
+    "(?=b)b",
+    "(?<=a)b",
+    "^a",
+    "^a|b",
+    "a$",
+    "\\bfoo",
+    "[\\u0100-\\uffff]",
+    "[\\u00ff\\u0178]",
+    ".",
+    "\\d+",
+    "(a)|b",
+    "\\u0178",
+    "\u{ff}",
+    "\\u{1F600}",
+    "[\\udc00-\\udfff]",
+    "\\udc00",
+    "(?:)",
+    "(?!a)",
+    "ab|\\u0100",
+    "k",
+];
+
+fn texts() -> Vec<Vec<u16>> {
+    let mut v: Vec<Vec<u16>> = [
+        "abcqqqq\u{e9} \u{ff} foo\nab",
+        "xxabcxx",
+        "\u{c9}\u{e9}a\u{ff}b\u{b5}",
+        "ba\nab",
+        "",
+        "kK\u{212a}",
+        "a\u{100}b\u{1F600}c\u{178}",
+        "\u{1F600}",
+    ]
+    .iter()
+    .map(|s| s.encode_utf16().collect())
+    .collect();
+    // Pseudo-random Latin-1 texts over a small alphabet, so patterns match often.
+    let alphabet: Vec<u16> = "abcqx\n \u{e9}\u{c9}\u{ff}9".encode_utf16().collect();
+    let mut seed = 12345u32;
+    for len in [3, 10, 40] {
+        for _ in 0..6 {
+            v.push(
+                (0..len)
+                    .map(|_| {
+                        seed = seed.wrapping_mul(1103515245).wrapping_add(12345);
+                        alphabet[(seed >> 16) as usize % alphabet.len()]
+                    })
+                    .collect(),
+            );
+        }
+    }
+    // A lone trail surrogate and a pair.
+    v.push(vec![0xd800, 0xdc00, 0xdc00, u16::from(b'a')]);
+    v
+}
+
+#[test]
+fn searches_equal_one_attempt_per_position() {
+    let mut checked = 0;
+    for &p in PATTERNS {
+        for flags in ["", "i", "m", "u", "iu"] {
+            let Ok(re) = Regex::with_flags(p, flags) else {
+                continue;
+            };
+            let unicode = flags.contains('u');
+            for units in texts() {
+                let latin1: Option<Vec<u8>> = units.iter().map(|&u| u8::try_from(u).ok()).collect();
+                let wide = if unicode {
+                    Text::Utf16(&units)
+                } else {
+                    Text::Ucs2(&units)
+                };
+                for start in 0..=units.len() + 1 {
+                    // (A Unicode search does not start inside a pair: skip such starts.)
+                    if unicode
+                        && start > 0
+                        && start < units.len()
+                        && (0xdc00..0xe000).contains(&units[start])
+                        && (0xd800..0xdc00).contains(&units[start - 1])
+                    {
+                        continue;
+                    }
+                    let want = oracle(&re, wide, &units, unicode, start);
+                    let got = search(&re, wide, start);
+                    assert_eq!(got, want, "/{p}/{flags} on {units:x?} from {start}");
+                    let it = if unicode {
+                        re.find_from_utf16(&units, start).next()
+                    } else {
+                        re.find_from_ucs2(&units, start).next()
+                    };
+                    assert_eq!(it.map(|m| groups(&m)), want, "iterator /{p}/{flags}");
+                    if let Some(bytes) = &latin1 {
+                        let got = search(&re, Text::Latin1(bytes), start);
+                        assert_eq!(got, want, "Latin-1 /{p}/{flags} on {units:x?} from {start}");
+                        let it = re.find_from_latin1(bytes, start).next();
+                        assert_eq!(
+                            it.map(|m| groups(&m)),
+                            want,
+                            "Latin-1 iterator /{p}/{flags}"
+                        );
+                    }
+                    checked += 1;
+                }
+            }
+        }
+    }
+    assert!(checked > 10_000, "{checked}");
+}
+
+#[test]
+fn latin1_text_is_matched_by_code_unit() {
+    // Above 0x7f a byte is the code unit (no UTF-8): U+00E9 is one byte.
+    let re = Regex::with_flags("\u{e9}+", "").unwrap();
+    let m = re.find_from_latin1(&[b'c', 0xe9, 0xe9], 0).next().unwrap();
+    assert_eq!(m.range(), 1..3);
+    // Case-insensitive: U+00FF and U+0178 are a case pair; the uppercase is not Latin-1.
+    let re = Regex::with_flags("\\u0178", "i").unwrap();
+    assert_eq!(
+        re.find_from_latin1(&[b'a', 0xff], 0)
+            .next()
+            .unwrap()
+            .range(),
+        1..2
+    );
+    // Backreferences and lookbehind read the bytes as code units (node:
+    // /(?<=\u00e9)(.)\1/i.exec("\u00e9\u00c9\u00e9x") matches at 1, "\u00c9\u00e9").
+    let re = Regex::with_flags("(?<=\u{e9})(.)\\1", "i").unwrap();
+    let m = re
+        .find_from_latin1(&[0xe9, 0xc9, 0xe9, b'x'], 0)
+        .next()
+        .unwrap();
+    assert_eq!(m.range(), 1..3);
+    let m = re.find_from_latin1(&[b'a', 0xc9, 0xe9], 0).next();
+    assert!(m.is_none());
+}
