+
+/// A long literal prefix on UTF-16 text: the start-position search compares a bounded part
+/// of the prefix, and each candidate it returns is a counted step, so the O(text x prefix)
+/// work polls (it was one step before).
+#[test]
+fn a_long_prefix_search_on_utf16_text_polls() {
+    let pattern = format!("{}b", "a".repeat(2000));
+    let re = Regex::new(&pattern).unwrap();
+    let mut text = vec![u16::from(b'a'); 20_000];
+    text.push(0x100);
+    for t in [Text::Ucs2(&text), Text::Utf16(&text)] {
+        let mut polls = 0u32;
+        let mut count = || {
+            polls += 1;
+            false
+        };
+        let mut limits = Limits {
+            budget: None,
+            poll_interval: 1000,
+            poll: &mut count,
+        };
+        assert!(re.find_limited(t, 0, &mut limits).unwrap().is_none());
+        assert!(polls >= 17, "{polls} polls");
+    }
+    // A prefix longer than the compared part still finds the right match.
+    let re = Regex::new(&format!("{}b", "a".repeat(40))).unwrap();
+    let mut text = vec![u16::from(b'a'); 100];
+    text.push(u16::from(b'b'));
+    text.push(0x100);
+    let mut never = || false;
+    let mut limits = Limits {
+        budget: None,
+        poll_interval: 1000,
+        poll: &mut never,
+    };
+    let m = re.find_limited(Text::Ucs2(&text), 0, &mut limits).unwrap();
+    assert_eq!(m.unwrap().range(), 60..101);
+}
