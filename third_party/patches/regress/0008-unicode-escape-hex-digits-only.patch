+/// Whether `s` is only ASCII hex digits (HexDigit, ECMA-262 12.9.3). Check it before
+/// `from_str_radix`: that function also takes a leading `+` sign, which is not a HexDigit.
+fn is_hex_digits(s: &str) -> bool {
+    s.bytes().all(|b| b.is_ascii_hexdigit())
+}
