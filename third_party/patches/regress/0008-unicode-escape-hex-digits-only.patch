+++ b/tests/unicode_escape_hex.rs
@@ -0,0 +1,113 @@
+//! `\u` escapes take only ASCII hex digits (HexDigit, ECMA-262 12.9.3). Rust's
+//! `from_str_radix` also takes a leading `+` sign, so `\u+0ff` was U+00FF, `\u{+1F600}` was
+//! U+1F600 and `(?<a\u+041>x)` was the group name `aA`. Without `u` and `v`, a `\u` that is
+//! not a RegExpUnicodeEscapeSequence is the identity escape `u` (Annex B); with `u` or `v`,
+//! and in a group name in every mode, it is a SyntaxError. Also: when a lead surrogate escape
+//! is not followed by a trail surrogate escape, the next escape starts at its `\u` (the parser
+//! lost that `\u`). Expected results: node v26.13.1.
+#![cfg(feature = "utf16")]
+
+use regress::Regex;
+
+/// Whether `pattern` with `flags` matches somewhere in the UTF-16 text `text`.
+fn matches(pattern: &str, flags: &str, text: &[u16]) -> bool {
+    let re = Regex::with_flags(pattern, flags).unwrap();
+    if flags.contains('u') {
+        re.find_from_utf16(text, 0).next().is_some()
+    } else {
+        re.find_from_ucs2(text, 0).next().is_some()
+    }
+}
+
+fn units(s: &str) -> Vec<u16> {
+    s.encode_utf16().collect()
+}
+
+/// The lone lead surrogate U+D83D, then `rest`.
+fn lead(rest: &str) -> Vec<u16> {
+    let mut v = vec![0xD83D];
+    v.extend(rest.encode_utf16());
+    v
+}
+
+fn is_syntax_error(pattern: &str, flags: &str) -> bool {
+    Regex::with_flags(pattern, flags).is_err()
+}
+
+#[test]
+fn plus_sign_without_u_is_identity_u_then_plus() {
+    // /\u+0ff/ is `u+` then `0ff`.
+    assert!(matches(r"^\u+0ff$", "", &units("uu0ff")));
+    assert!(matches(r"^\u+0ff$", "", &units("u0ff")));
+    assert!(!matches(r"\u+0ff", "", &units("\u{ff}")));
+    assert!(!matches(r"\u+0ff", "", &units("+0ff")));
+    // In a class: `u`, `+`, `0`, `4`, `1`.
+    assert!(matches(r"[\u+041]", "", &units("+")));
+    assert!(matches(r"[\u+041]", "", &units("u")));
+    assert!(!matches(r"[\u+041]", "", &units("A")));
+    // Valid escapes do not change.
+    assert!(matches(r"^\u0041$", "", &units("A")));
+    assert!(matches(r"^\u{1F600}$", "u", &units("\u{1F600}")));
+    assert!(matches(r"^\uD83D\uDE00$", "u", &units("\u{1F600}")));
+}
+
+#[test]
+fn plus_sign_with_u_is_a_syntax_error() {
+    assert!(is_syntax_error(r"\u+0ff", "u"));
+    assert!(is_syntax_error(r"[\u+1F6]", "u"));
+    assert!(is_syntax_error(r"\u{+1F600}", "u"));
+    assert!(is_syntax_error(r"[\u{+1F600}]", "u"));
+}
+
+#[test]
+fn plus_sign_in_a_trail_surrogate_escape() {
+    // Without `u`: the lead surrogate, then `\u` is the identity escape `u`: `u+` then
+    // `DE00`, and in a class U+D83D, `u`, `+`, `D`, `E`, `0`.
+    assert!(matches(r"^\uD83D\u+DE00$", "", &lead("uuDE00")));
+    assert!(!matches(r"\uD83D\u+DE00", "", &lead("DE00")));
+    assert!(matches(r"[\uD83D\u+DE00]", "", &units("u")));
+    assert!(matches(r"[\uD83D\u+DE00]", "", &units("+")));
+    assert!(matches(r"[\uD83D\u+DE00]", "", &units("E")));
+    assert!(is_syntax_error(r"\uD83D\u+DE00", "u"));
+    assert!(is_syntax_error(r"[\uD83D\u+DE00]", "u"));
+}
+
+#[test]
+fn a_lead_surrogate_keeps_the_next_escape() {
+    // \u0041 after a lead surrogate is not a trail: it is the next escape, `A`.
+    assert!(matches(r"^\uD83D\u0041$", "", &lead("A")));
+    assert!(!matches(r"\uD83D\u0041", "", &lead("0041")));
+    assert!(matches(r"[\uD83D\u0041]", "", &units("A")));
+    assert!(!matches(r"[\uD83D\u0041]", "", &units("0")));
+    assert!(matches(r"^\uD83D\uzzzz$", "", &lead("uzzzz")));
+    assert!(is_syntax_error(r"\uD83D\uzzzz", "u"));
+}
+
+#[test]
+fn plus_sign_in_a_group_name_is_a_syntax_error() {
+    for flags in ["", "u"] {
+        assert!(is_syntax_error(r"(?<a\u+041>x)", flags), "/{flags}");
+        assert!(is_syntax_error(r"(?<\u+041>x)", flags), "/{flags}");
+        assert!(is_syntax_error(r"(?<a\u{+41}>x)", flags), "/{flags}");
+    }
+    assert!(matches(r"(?<a\u0041>x)\k<aA>", "", &units("xx")));
+}
+
+#[test]
+fn plus_sign_with_the_flag_strings_u_and_v_is_a_syntax_error() {
+    // `Regex::with_flags(_, "v")` sets only `unicode_sets`, not `unicode`. `v` is Unicode mode
+    // too, so a `\u` that is not a RegExpUnicodeEscapeSequence is a SyntaxError (node: the same).
+    for flags in ["u", "v"] {
+        assert!(is_syntax_error(r"[\u+fff-z]", flags), "/{flags}");
+        assert!(is_syntax_error(r"\u+0ff", flags), "/{flags}");
+        assert!(is_syntax_error(r"\u{+1F600}", flags), "/{flags}");
+        assert!(is_syntax_error(r"\uD83D\u+DE00", flags), "/{flags}");
+        assert!(is_syntax_error(r"[\uD83D\u+DE00]", flags), "/{flags}");
+    }
+    // Without `u` and `v`: the class `u`, `+`, `f-z`.
+    assert!(matches(r"[\u+fff-z]", "", &units("+")));
+    assert!(!matches(r"[\u+fff-z]", "", &units("a")));
+    // Valid escapes with the flag string `v` do not change.
+    let re = Regex::with_flags(r"^\uD83D\uDE00\u{41}$", "v").unwrap();
+    assert!(re.find_from_utf16(&units("\u{1F600}A"), 0).next().is_some());
+}
