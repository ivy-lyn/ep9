diff --git a/tests/named_backrefs.rs b/tests/named_backrefs.rs
new file mode 100644
index 0000000..a5e62eb
--- /dev/null
+++ b/tests/named_backrefs.rs
@@ -0,0 +1,58 @@
+//! Backreferences to a name that several capture groups share (ES2025 duplicate named
+//! groups), and `\k` in a class when the pattern has group names. The expected results are
+//! those of test262 `built-ins/RegExp/named-groups/duplicate-names-exec.js` and of node v24.
+
+use regress::Regex;
+
+/// The groups of the first match of `pattern` in `text` (`None` for no match), as strings.
+fn exec(pattern: &str, text: &str) -> Option<Vec<Option<String>>> {
+    let re = Regex::new(pattern).unwrap();
+    let m = re.find(text)?;
+    Some(m.groups().map(|g| g.map(|r| text[r].to_string())).collect())
+}
+
+fn groups(v: &[Option<&str>]) -> Option<Vec<Option<String>>> {
+    Some(v.iter().map(|g| g.map(str::to_string)).collect())
+}
+
+#[test]
+fn a_shared_name_refers_to_the_group_that_matched() {
+    let p = r"(?:(?<x>a)|(?<x>b))\k<x>";
+    assert_eq!(exec(p, "aa"), groups(&[Some("aa"), Some("a"), None]));
+    // An alternation of backrefs would match "b" with an empty \k<x> (group 1 unset).
+    assert_eq!(exec(p, "bb"), groups(&[Some("bb"), None, Some("b")]));
+    assert_eq!(exec(p, "abab"), None);
+    assert_eq!(exec(p, "cdef"), None);
+
+    let p = r"(?:(?:(?<x>a)|(?<x>b))\k<x>){2}";
+    assert_eq!(exec(p, "aabb"), groups(&[Some("aabb"), None, Some("b")]));
+    assert_eq!(exec(p, "abab"), None);
+
+    let p = r"^(?:(?<a>x)|(?<a>y)|z)\k<a>$";
+    assert_eq!(exec(p, "xx"), groups(&[Some("xx"), Some("x"), None]));
+    assert_eq!(exec(p, "z"), groups(&[Some("z"), None, None]));
+    assert_eq!(exec(p, "zz"), None);
+
+    let p = r"^(?:(?<a>x)|(?<a>y)|z){2}\k<a>$";
+    assert_eq!(exec(p, "xz"), groups(&[Some("xz"), None, None]));
+    assert_eq!(exec(p, "yz"), groups(&[Some("yz"), None, None]));
+    assert_eq!(exec(p, "xzx"), None);
+    assert_eq!(exec(p, "yzy"), None);
+
+    // Backwards (in a lookbehind) and case-insensitive.
+    let re = Regex::with_flags(r"(?<=\k<n>(?:(?<n>a)|(?<n>b)))c", "").unwrap();
+    assert_eq!(re.find("bbc").map(|m| m.range()), Some(2..3));
+    assert_eq!(re.find("abc").map(|m| m.range()), None);
+    let re = Regex::with_flags(r"(?:(?<n>a)|(?<n>b))\k<n>", "i").unwrap();
+    assert_eq!(re.find("bB").map(|m| m.range()), Some(0..2));
+}
+
+#[test]
+fn k_in_a_class_with_group_names_is_an_error() {
+    for p in [r"[\k<a>](?<a>x)", r"[\k](?<a>x)", r"(?<a>x)[\k<a>]"] {
+        assert!(Regex::new(p).is_err(), "{p}");
+    }
+    // Without a group name, \k in a class is the identity escape k.
+    let re = Regex::new(r"[\k<a>]").unwrap();
+    assert_eq!(re.find("<k").map(|m| m.range()), Some(0..1));
+}
