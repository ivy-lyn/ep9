+/// One search of `re` in `input` from code unit `start` (with `anchored`, one attempt at
+/// `start`), using the memory of `scratch` and writing the match into `captures`
+/// (`Regex::exec_into`).
+#[cfg(feature = "utf16")]
+pub(crate) fn exec_into<Input: InputIndexer<Position = IndexPosition<'static>>>(
+    re: &CompiledRegex,
+    input: Input,
+    start: usize,
+    anchored: bool,
+    scratch: &mut Scratch,
+    captures: &mut Vec<Option<Range<usize>>>,
+    limits: &mut Limits<'_>,
+) -> Result<bool, Stopped> {
+    captures.clear();
+    let Some(pos) = input.try_move_right(input.left_end(), start) else {
+        return Ok(false);
+    };
+    let matcher = MatchAttempter::with_scratch(re, input.left_end(), limits, scratch);
+    let mut exec = BacktrackExecutor::new(input, matcher);
+    let found = if anchored {
+        exec.span_at(pos)
+    } else {
+        exec.next_span(pos, &mut None)
+    };
+    let stopped = exec.matcher.stopped();
+    if let (Some((start, end)), None) = (found, stopped) {
+        let offset = |p| input.pos_to_offset(p);
+        captures.reserve(exec.matcher.s.groups.len() + 1);
+        captures.push(Some(offset(start)..offset(end)));
+        captures.extend(
+            exec.matcher
+                .s
+                .groups
+                .iter()
+                .map(|gd| gd.as_range().map(|r| offset(r.start)..offset(r.end))),
+        );
+    }
+    exec.matcher.into_scratch(scratch);
+    match stopped {
+        Some(why) => Err(why),
+        None => Ok(found.is_some()),
+    }
+}
