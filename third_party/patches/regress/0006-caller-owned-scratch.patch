+/// The memory of the backtracking engine, kept by the caller across searches
+/// (`Regex::exec_into`) so that a search allocates nothing once it has grown. It holds no
+/// position of a finished search (each search clears it first).
+#[cfg(feature = "utf16")]
+#[derive(Debug, Default)]
+pub struct Scratch {
+    bts: Vec<BacktrackInsn<IndexPosition<'static>>>,
+    loops: Vec<LoopData<IndexPosition<'static>>>,
+    groups: Vec<GroupData<IndexPosition<'static>>>,
+}
+
+#[cfg(feature = "utf16")]
+impl Scratch {
+    /// The bytes of memory the scratch holds (a search that backtracked a lot leaves a large
+    /// backtrack stack).
+    pub fn memory(&self) -> usize {
+        self.bts.capacity() * core::mem::size_of::<BacktrackInsn<IndexPosition<'static>>>()
+            + self.loops.capacity() * core::mem::size_of::<LoopData<IndexPosition<'static>>>()
+            + self.groups.capacity() * core::mem::size_of::<GroupData<IndexPosition<'static>>>()
+    }
+}
