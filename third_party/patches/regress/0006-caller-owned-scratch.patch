+//! `Regex::exec_into`: searches that keep the engine's memory in a caller-owned `Scratch`
+//! and write the match into a caller-owned capture list.
+#![cfg(feature = "utf16")]
+
+use regress::{Limits, Range, Regex, Scratch, Stopped, Text};
+
+fn no_limits<T>(f: impl FnOnce(&mut Limits<'_>) -> T) -> T {
+    let mut never = || false;
+    let mut limits = Limits {
+        budget: None,
+        poll_interval: 4096,
+        poll: &mut never,
+    };
+    f(&mut limits)
+}
+
+/// The match as `find_limited` / `match_at_limited` give it: the whole match, then the groups.
+fn reference(re: &Regex, text: Text<'_>, start: usize, anchored: bool) -> Vec<Option<Range>> {
+    let m = no_limits(|l| {
+        if anchored {
+            re.match_at_limited(text, start, l)
+        } else {
+            re.find_limited(text, start, l)
+        }
+    })
+    .unwrap();
+    match m {
+        Some(m) => m.groups().collect(),
+        None => Vec::new(),
+    }
+}
+
+#[test]
+fn one_scratch_serves_many_regexes_and_texts() {
+    let regexes = [
+        Regex::new("(a)(b)?(?:(c)|d)").unwrap(),
+        Regex::new("x+").unwrap(),
+        Regex::with_flags("(?<n>\u{e9})|(z)", "i").unwrap(),
+        Regex::with_flags("(.)(?=(\\1))", "u").unwrap(),
+        Regex::new("((a+)+)b").unwrap(),
+        Regex::new("").unwrap(),
+    ];
+    let words = [
+        "zzabd",
+        "xxacx",
+        "\u{c9}\u{e9}a",
+        "\u{1F600}\u{1F600}a",
+        "aaab",
+        "",
+    ];
+    let mut scratch = Scratch::default();
+    let mut caps = vec![Some(7..9); 3];
+    for re in &regexes {
+        for word in words {
+            let units: Vec<u16> = word.encode_utf16().collect();
+            let latin1: Option<Vec<u8>> = units.iter().map(|&u| u8::try_from(u).ok()).collect();
+            for start in 0..=units.len() + 1 {
+                for anchored in [false, true] {
+                    let mut texts = vec![Text::Ucs2(&units), Text::Utf16(&units)];
+                    if let Some(b) = &latin1 {
+                        texts.push(Text::Latin1(b));
+                    }
+                    for text in texts {
+                        let want = reference(re, text, start, anchored);
+                        let found = no_limits(|l| {
+                            re.exec_into(text, start, anchored, &mut scratch, &mut caps, l)
+                        })
+                        .unwrap();
+                        assert_eq!(found, !want.is_empty());
+                        assert_eq!(caps, want, "{re:?} {word:?} {start} {anchored} {text:?}");
+                    }
+                }
+            }
+        }
+    }
+}
+
+/// A stop leaves the scratch usable for the next search.
+#[test]
+fn a_stopped_search_leaves_a_usable_scratch() {
+    let re = Regex::new("(a+)+b").unwrap();
+    let text: Vec<u16> = "a".repeat(28).encode_utf16().collect();
+    let mut scratch = Scratch::default();
+    let mut caps = Vec::new();
+    let mut stop = || true;
+    let mut limits = Limits {
+        budget: None,
+        poll_interval: 64,
+        poll: &mut stop,
+    };
+    let r = re.exec_into(
+        Text::Ucs2(&text),
+        0,
+        false,
+        &mut scratch,
+        &mut caps,
+        &mut limits,
+    );
+    assert_eq!(r, Err(Stopped::Interrupted));
+    let mut ok = text.clone();
+    ok.push(u16::from(b'b'));
+    let r = no_limits(|l| re.exec_into(Text::Ucs2(&ok), 0, false, &mut scratch, &mut caps, l));
+    assert_eq!(r, Ok(true));
+    assert_eq!(caps, vec![Some(0..29), Some(0..28)]);
+    // The scratch kept its memory; a new one holds none.
+    assert!(scratch.memory() > 0);
+    assert_eq!(Scratch::default().memory(), 0);
+}
