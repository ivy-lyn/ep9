#!/usr/bin/env bash
# sbx - client for the ep9-x86-sandbox Worker (real x86_64 Linux on Cloudflare Containers).
#
# Needs only: bash (3.2 ok), curl, jq, base64, split, shasum (or sha256sum), zstd, tar, git.
# URL comes from  $SBX_URL_FILE   (default: <dir of this script>/.url); it must be https://
#   (http://localhost, 127.0.0.1 or [::1] only with SBX_ALLOW_INSECURE_LOCAL=1, for a local test).
# Token comes from $SBX_TOKEN_FILE (default: <dir of this script>/.token)
# The token is only ever read inside this script and passed to curl via a
# process-substitution header file (never on a command line, never printed).
#
# Commands (see README.md for details):
#   sbx exec    <id> '<cmd>' [timeout_s]           run via `bash -c`, print stdout/stderr, exit with remote code
#   sbx put     <id> <local-file> <remote-path>    chunked upload, sha256 verified on both sides
#   sbx get     <id> <remote-path> <local-path>    chunked download, sha256 verified
#   sbx push-git [--clear] <id> <git-dir> <commit> <remote-dir>
#                                                  git archive + .sbx-manifest | zstd -> put -> extract;
#                                                  refuses a non-empty <remote-dir> unless --clear
#   sbx manifest <git-dir> <commit>                print the .sbx-manifest of <commit> (local only)
#   sbx bg      <id> <job> '<cmd>'                 start a background job (/work/jobs/<job>.log/.exit)
#   sbx wait    <id> <job> [poll_s]                poll job (keeps sandbox awake), stream log, exit with job code
#   sbx destroy <id>                               stop the container now (files are lost)
#   sbx health  [id]                               auth check; with id also reports running state (never starts it)
set -euo pipefail

SBX_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
URL_FILE=${SBX_URL_FILE:-$SBX_DIR/.url}
TOKEN_FILE=${SBX_TOKEN_FILE:-$SBX_DIR/.token}
CHUNK=${SBX_CHUNK_BYTES:-2097152}          # 2 MiB raw per request (≈2.8 MB base64); keeps Worker/DO memory low
START_RETRIES=${SBX_START_RETRIES:-36}     # retries while Cloudflare has no instance ready (10 s apart)
PAR=${SBX_PARALLEL:-4}                     # concurrent chunk requests for put/get (~1.7 MB/s per stream)

die() { echo "sbx: $*" >&2; exit 99; }

# Where uploads land on the box. push-git never extracts into it or into a parent of it.
UPLOAD_DIR=/work/.upload

# URL, token and the network tools: only the commands that talk to the Worker need them.
# push-git calls this after its local checks, and `sbx manifest` never calls it.
sbx_init_remote() {
	[ "$CHUNK" -ge 1024 ] && [ "$CHUNK" -le 6291456 ] || die "SBX_CHUNK_BYTES must be 1024..6291456 (the Worker caps stdout at 8 MiB and base64 adds 1/3)"
	[ -r "$URL_FILE" ] || die "missing URL file $URL_FILE"
	[ -r "$TOKEN_FILE" ] || die "missing token file $TOKEN_FILE"
	URL=$(tr -d ' \n\r' < "$URL_FILE")
	URL=${URL%/}
	# The token is a Bearer header: only ever send it over HTTPS. Plain http is
	# allowed only for a local `wrangler dev` test, and only when asked for.
	local re='^http://(127\.0\.0\.1|localhost|\[::1\])(:[0-9]{1,5})?(/.*)?$'
	case "$URL" in
		https://*) CURL_PROTO='=https' ;;
		*)
			if [[ "$URL" =~ $re ]] && [[ "$URL" != *@* ]] && [ "${SBX_ALLOW_INSECURE_LOCAL:-}" = 1 ]; then
				CURL_PROTO='=http'
			else
				die "refusing non-https URL '$URL' from $URL_FILE (the token must only travel over HTTPS; SBX_ALLOW_INSECURE_LOCAL=1 allows http://localhost / 127.0.0.1 / [::1] for a local test)"
			fi
			;;
	esac
	local t
	for t in curl jq base64; do command -v "$t" >/dev/null || die "need $t"; done
}

# Hash from stdin: with a path argument, shasum and GNU sha256sum escape a name
# that has `\` or a newline and put a `\` in front of the hash.
if command -v shasum >/dev/null; then
	sha256_file() { shasum -a 256 < "$1" | awk '{print $1}'; }
elif command -v sha256sum >/dev/null; then
	sha256_file() { sha256sum < "$1" | awk '{print $1}'; }
else
	die "need shasum or sha256sum"
fi
if printf 'QQ==' | base64 -d >/dev/null 2>&1; then B64D="-d"; else B64D="-D"; fi
b64enc() { base64 < "$1" | tr -d '\n\r'; }
b64dec() { base64 "$B64D"; }
file_size() { wc -c < "$1" | tr -d ' '; }

sbx_make_work() {
	WORK=$(mktemp -d "${TMPDIR:-/tmp}/sbx.XXXXXX")
	trap 'rm -rf "$WORK"' EXIT
}

check_id() { [[ "$1" =~ ^[a-z0-9-]{1,40}$ ]] || die "bad id '$1' (must match ^[a-z0-9-]{1,40}\$)"; }
check_job() { [[ "$1" =~ ^[A-Za-z0-9._-]{1,64}$ ]] || die "bad job name '$1'"; }
q() { printf '%q' "$1"; }  # quote one word for the remote bash

# api METHOD PATH BODY_FILE OUT_FILE MAX_TIME -> prints HTTP code, or on a transport error:
#   000 = curl failed before it sent the request (DNS, TCP connect, TLS handshake: exit 6, 7, 35)
#   001 = any other curl failure (reset, empty reply, HTTP/2 error, cut body, timeout): the
#         request may have reached the Worker, so the step may have run
api() {
	local method=$1 path=$2 body=$3 out=$4 maxt=${5:-600} code rc=0
	if [ -n "$body" ]; then
		code=$(curl -sS --proto "$CURL_PROTO" -X "$method" -o "$out" -w '%{http_code}' --connect-timeout 20 --max-time "$maxt" \
			-H @<(printf 'Authorization: Bearer %s\n' "$(tr -d ' \n\r' < "$TOKEN_FILE")") \
			-H 'content-type: application/json' --data-binary @"$body" "$URL$path") || rc=$?
	else
		code=$(curl -sS --proto "$CURL_PROTO" -X "$method" -o "$out" -w '%{http_code}' --connect-timeout 20 --max-time "$maxt" \
			-H @<(printf 'Authorization: Bearer %s\n' "$(tr -d ' \n\r' < "$TOKEN_FILE")") \
			"$URL$path") || rc=$?
	fi
	if [ "$rc" != 0 ]; then
		case $rc in 6 | 7 | 35) code=000 ;; *) code=001 ;; esac
	fi
	printf '%s' "$code"
}

# Retry only when the request never reached a container ("no container
# instance ... try again later": first deploy or all max_instances busy) or
# curl could not connect; never on a command that may have run.
# HTTP 500 "The container connection is temporarily unavailable, try again
# shortly" is retried (same 10 s x SBX_START_RETRIES bound) only when IDEM=1
# (the step can run twice: one /write chunk, a read-only step of `get`) or the
# Worker answered `"ran": false` (/exec failed before it launched the command).
# api_retry METHOD PATH BODY_FILE OUT_FILE MAX_TIME [IDEM]
api_retry() {
	local method=$1 path=$2 body=$3 out=$4 maxt=${5:-600} idem=${6:-0} code n=0 why
	while :; do
		code=$(api "$method" "$path" "$body" "$out" "$maxt")
		if [ "$code" = 500 ] && grep -q 'no container instance' "$out" 2>/dev/null && [ "$n" -lt "$START_RETRIES" ]; then
			n=$((n + 1)); echo "sbx: no container instance yet, retry $n/$START_RETRIES in 10s" >&2; sleep 10; continue
		fi
		if [ "$code" = 500 ] && grep -q 'container connection is temporarily unavailable' "$out" 2>/dev/null; then
			if [ "$idem" = 1 ] || [ "$(jq -r '.ran' "$out" 2>/dev/null)" = false ]; then
				if [ "$n" -lt "$START_RETRIES" ]; then
					n=$((n + 1))
					if [ "$idem" = 1 ]; then why="this step is safe to repeat"; else why="the command did not run"; fi
					echo "sbx: container connection temporarily unavailable ($why), retry $n/$START_RETRIES in 10s" >&2; sleep 10; continue
				fi
			else
				echo "sbx: container connection temporarily unavailable after the command was launched; it may have run, so it is not retried" >&2
			fi
		fi
		if [ "$code" = 000 ] && [ "$n" -lt 3 ]; then
			n=$((n + 1)); echo "sbx: could not connect (nothing was sent), retry $n/3" >&2; sleep 5; continue
		fi
		if [ "$code" = 001 ]; then
			if [ "$idem" = 1 ] && [ "$n" -lt 3 ]; then
				n=$((n + 1)); echo "sbx: connection broke after the request was sent; this step is safe to repeat, retry $n/3" >&2; sleep 5; continue
			fi
			echo "sbx: connection broke after the request was sent; the step may have run, so it is not retried" >&2
		fi
		break
	done
	printf '%s' "$code"
}

# rexec ID CMD TIMEOUT_S OUT_JSON [IDEM] -> returns 0 if HTTP 200 (remote exit code is in the JSON)
# IDEM=1 only for commands that are safe to run twice (read-only).
rexec() {
	local id=$1 cmd=$2 tmo=$3 out=$4 idem=${5:-0} body="$4.req.json" code
	jq -n --arg id "$id" --arg cmd "$cmd" --argjson t "$((tmo * 1000))" '{id:$id, cmd:$cmd, timeout_ms:$t}' > "$body"
	code=$(api_retry POST /exec "$body" "$out" "$((tmo + 120))" "$idem")
	rm -f "$body"
	if [ "$code" != 200 ]; then
		echo "sbx: /exec HTTP $code: $(head -c 2000 "$out" 2>/dev/null)" >&2
		grep -q 'Maximum number of running container instances' "$out" 2>/dev/null \
			&& echo "sbx: all sandbox slots are in use; 'sbx destroy <id>' one you no longer need" >&2
		grep -q 'was destroyed by a /destroy that ran while this request was in flight' "$out" 2>/dev/null \
			&& echo "sbx: a destroy of this id finished while the request waited; nothing ran; send it again" >&2
		grep -q 'is attached to a container it did not start' "$out" 2>/dev/null \
			&& echo "sbx: this id is not on the container it started; 'sbx destroy <id>' and start again" >&2
		grep -q 'Network connection lost' "$out" 2>/dev/null \
			&& echo "sbx: the Durable Object restarted mid-request; the command may still be running in the container (use 'sbx bg' + 'sbx wait' for long work)" >&2
		return 1
	fi
}

# rexec_ok ID CMD TIMEOUT_S [IDEM] -> prints remote stdout; fails (with stderr) if remote exit != 0
rexec_ok() {
	local out ec
	out=$(mktemp "$WORK/r.XXXXXX")
	rexec "$1" "$2" "$3" "$out" "${4:-0}" || return 1
	ec=$(jq -r '.exitCode' "$out")
	if [ "$ec" != 0 ]; then
		echo "sbx: remote command failed (exit $ec): $2" >&2
		jq -j '.stderr' "$out" >&2
		jq -j '.stdout' "$out" >&2
		rm -f "$out"; return 1
	fi
	jq -j '.stdout' "$out"
	rm -f "$out"
}

cmd_exec() {
	[ $# -ge 2 ] || die "usage: sbx exec <id> '<cmd>' [timeout_s]"
	local id=$1 cmd=$2 tmo=${3:-600} out="$WORK/exec.out.json" ec
	check_id "$id"
	[[ "$tmo" =~ ^[0-9]+$ ]] && [ "$tmo" -ge 1 ] && [ "$tmo" -le 21600 ] || die "timeout_s must be 1..21600"
	rexec "$id" "$cmd" "$tmo" "$out" || exit 98
	jq -j '.stdout' "$out"
	jq -j '.stderr' "$out" >&2
	if [ "$(jq -r '.stdoutTruncated or .stderrTruncated' "$out")" = true ]; then
		echo "sbx: output truncated (stdout $(jq -r .stdoutBytes "$out") B, stderr $(jq -r .stderrBytes "$out") B); redirect to a file and use 'sbx get'" >&2
	fi
	[ "$(jq -r '.timedOut' "$out")" = true ] && echo "sbx: command timed out after ${tmo}s" >&2
	ec=$(jq -r '.exitCode' "$out")
	exit "$ec"
}

# write_chunk ID LOCAL_CHUNK REMOTE_PATH -> verifies the sha256 the Worker computed
write_chunk() {
	local id=$1 f=$2 rpath=$3 want got body="$2.json" out="$2.out" code n=0
	want=$(sha256_file "$f")
	b64enc "$f" > "$f.b64"
	jq -n --arg id "$id" --arg path "$rpath" --rawfile b "$f.b64" '{id:$id, path:$path, content_b64:$b}' > "$body"
	rm -f "$f.b64"
	while :; do
		# One chunk to its own temp path: writing it twice is harmless (IDEM=1).
		code=$(api_retry POST /write "$body" "$out" 600 1)
		got=$(jq -r '.sha256 // empty' "$out" 2>/dev/null || true)
		if [ "$code" = 200 ] && [ "$got" = "$want" ]; then break; fi
		n=$((n + 1))
		[ "$n" -le 3 ] || { echo "sbx: /write $rpath failed: HTTP $code $(head -c 500 "$out")" >&2; return 1; }
		echo "sbx: /write retry $n (HTTP $code)" >&2; sleep 3
	done
	rm -f "$body" "$out"
}

# Sliding-window job pool (bash 3.2 has no `wait -n`): at most $PAR running.
POOL_PIDS=()
POOL_FAIL=0
pool_reap() {
	local keep=() p
	for p in ${POOL_PIDS[@]+"${POOL_PIDS[@]}"}; do
		if kill -0 "$p" 2>/dev/null; then keep+=("$p"); else wait "$p" || POOL_FAIL=1; fi
	done
	POOL_PIDS=(${keep[@]+"${keep[@]}"})
}
pool_run() {
	while [ "${#POOL_PIDS[@]}" -ge "$PAR" ]; do
		pool_reap
		[ "${#POOL_PIDS[@]}" -ge "$PAR" ] && sleep 0.2
	done
	"$@" &
	POOL_PIDS+=("$!")
}
pool_wait() {
	local p
	for p in ${POOL_PIDS[@]+"${POOL_PIDS[@]}"}; do wait "$p" || POOL_FAIL=1; done
	POOL_PIDS=()
	[ "$POOL_FAIL" = 0 ]
}
put_one() { write_chunk "$1" "$2" "$3" && rm -f "$2" && echo "sbx:   chunk $4 ok" >&2; }
get_one() { get_chunk "$1" "$2" "$3" "$4" && echo "sbx:   chunk $5 ok" >&2; }

cmd_put() {
	[ $# -eq 3 ] || die "usage: sbx put <id> <local-file> <remote-path>"
	local id=$1 lf=$2 rp=$3 size sha nparts i=0 up rsha
	check_id "$id"
	[ -f "$lf" ] || die "no such file $lf"
	case "$rp" in /*) ;; *) die "remote path must be absolute" ;; esac
	size=$(file_size "$lf"); sha=$(sha256_file "$lf")
	up="$UPLOAD_DIR/put-$(date +%s)-$$-$RANDOM"
	mkdir -p "$WORK/parts"
	if [ "$size" -eq 0 ]; then : > "$WORK/parts/p.aaaaaa"; else split -b "$CHUNK" -a 6 "$lf" "$WORK/parts/p."; fi
	nparts=$(ls "$WORK/parts" | wc -l | tr -d ' ')
	echo "sbx: put $lf ($size B, sha256 $sha) -> $id:$rp in $nparts chunk(s)" >&2
	for f in "$WORK"/parts/p.*; do
		i=$((i + 1))
		pool_run put_one "$id" "$f" "$up/$(basename "$f")" "$i/$nparts"
	done
	pool_wait || exit 98
	rsha=$(rexec_ok "$id" "set -e; mkdir -p \"\$(dirname $(q "$rp"))\"; cat $(q "$up")/p.* > $(q "$rp").sbxpart; mv -f $(q "$rp").sbxpart $(q "$rp"); rm -rf $(q "$up"); sha256sum < $(q "$rp") | cut -d' ' -f1" 600) || exit 98
	rsha=$(printf '%s' "$rsha" | tr -d '\n')
	if [ "$rsha" != "$sha" ]; then echo "sbx: sha256 MISMATCH local=$sha remote=$rsha" >&2; exit 97; fi
	echo "sbx: put ok sha256 $sha" >&2
}

# get_chunk ID REMOTE_PATH INDEX LOCAL_OUT (retries 3x; reads are idempotent)
get_chunk() {
	local id=$1 rp=$2 i=$3 dst=$4 out="$4.json" n=0
	while :; do
		if rexec "$id" "dd if=$(q "$rp") bs=$CHUNK skip=$i count=1 iflag=fullblock status=none | base64 -w0" 120 "$out" 1 \
			&& [ "$(jq -r '.exitCode' "$out")" = 0 ] && [ "$(jq -r '.stdoutTruncated' "$out")" = false ]; then
			jq -j '.stdout' "$out" | b64dec > "$dst" && break
		fi
		n=$((n + 1))
		[ "$n" -le 3 ] || { echo "sbx: chunk $i read failed: $(jq -j .stderr "$out" 2>/dev/null)" >&2; return 1; }
		echo "sbx: chunk $i retry $n" >&2; sleep 3
	done
	rm -f "$out" "$out.req.json"
}

cmd_get() {
	[ $# -eq 3 ] || die "usage: sbx get <id> <remote-path> <local-path>"
	local id=$1 rp=$2 lp=$3 info size rsha n i=0 lsha
	check_id "$id"
	info=$(rexec_ok "$id" "stat -c %s $(q "$rp") && sha256sum < $(q "$rp") | cut -d' ' -f1" 600 1) || exit 98
	size=$(printf '%s\n' "$info" | sed -n 1p); rsha=$(printf '%s\n' "$info" | sed -n 2p)
	n=$(( (size + CHUNK - 1) / CHUNK ))
	echo "sbx: get $id:$rp ($size B, sha256 $rsha) in $n chunk(s)" >&2
	mkdir -p "$WORK/get"
	while [ "$i" -lt "$n" ]; do
		pool_run get_one "$id" "$rp" "$i" "$WORK/get/c.$i" "$((i + 1))/$n"
		i=$((i + 1))
	done
	pool_wait || exit 98
	: > "$lp.sbxpart"
	i=0
	while [ "$i" -lt "$n" ]; do cat "$WORK/get/c.$i" >> "$lp.sbxpart"; rm -f "$WORK/get/c.$i"; i=$((i + 1)); done
	lsha=$(sha256_file "$lp.sbxpart")
	if [ "$lsha" != "$rsha" ]; then echo "sbx: sha256 MISMATCH remote=$rsha local=$lsha" >&2; rm -f "$lp.sbxpart"; exit 97; fi
	mv -f "$lp.sbxpart" "$lp"
	echo "sbx: get ok sha256 $lsha" >&2
}

# ---- push-git and its local parts (tests/push-git-local.sh tests these with no sandbox) ----
#
# .sbx-manifest (written into <remote-dir> by push-git, read by tools/test262):
#   line 1:    commit <full commit id>
#   then:      <blob id> <path>    one line per file of the archive (git ls-tree -r <commit>;
#              gitlinks are skipped: git archive writes no file for them), sorted by path
#              byte by byte (LC_ALL=C). <path> is the raw path from the root, not quoted; it
#              is everything after the first space. Every line ends with \n.
# A path with a newline cannot be written this way, so push-git refuses such a commit.

# pg_check_remote_dir DIR: absolute, no `.`, `..`, `//` or trailing `/`, not `/`, and not
# UPLOAD_DIR or a parent of it (a --clear there would delete the upload).
pg_check_remote_dir() {
	local rd=$1
	case "$rd" in /*) ;; *) die "remote dir must be absolute: '$rd'" ;; esac
	[ "$rd" != / ] || die "remote dir must not be /"
	case "$rd/" in *//* | */./* | */../*) die "remote dir must be a plain path (no '.', '..', '//' or trailing '/'): '$rd'" ;; esac
	case "$rd" in *$'\n'*) die "remote dir must not hold a newline" ;; esac
	case "$UPLOAD_DIR/" in "$rd"/*) die "remote dir '$rd' holds the upload dir $UPLOAD_DIR; use a dir of its own, such as /work/src" ;; esac
}

# pg_parse_args ARGS... -> sets PG_CLEAR PG_ID PG_GD PG_COMMIT PG_RD (no remote call).
pg_parse_args() {
	PG_CLEAR=0
	while [ $# -gt 0 ]; do
		case "$1" in
			--clear) PG_CLEAR=1; shift ;;
			--) shift; break ;;
			-*) die "push-git: unknown option '$1' (usage: sbx push-git [--clear] <id> <git-dir> <commit> <remote-dir>)" ;;
			*) break ;;
		esac
	done
	[ $# -eq 4 ] || die "usage: sbx push-git [--clear] <id> <git-dir> <commit> <remote-dir>"
	PG_ID=$1 PG_GD=$2 PG_COMMIT=$3 PG_RD=$4
	check_id "$PG_ID"
	pg_check_remote_dir "$PG_RD"
}

# sbx_manifest GIT_DIR FULL_COMMIT OUT_FILE -> writes the manifest (format above); 1 on error.
sbx_manifest() {
	local gd=$1 full=$2 out=$3 raw="$3.raw" rec meta path mode type sha
	git -C "$gd" ls-tree -r -z --full-tree "$full" > "$raw" || { echo "sbx: git ls-tree $full failed" >&2; return 1; }
	: > "$out.body"
	while IFS= read -r -d '' rec; do
		meta=${rec%%$'\t'*}; path=${rec#*$'\t'}
		read -r mode type sha <<< "$meta"
		case "$type" in
			blob) ;;
			commit) continue ;;  # gitlink: git archive writes an empty dir, no file
			*) echo "sbx: unexpected ls-tree entry '$rec'" >&2; return 1 ;;
		esac
		case "$path" in *$'\n'*) echo "sbx: commit $full has a path with a newline; .sbx-manifest cannot name it" >&2; return 1 ;; esac
		case "$path" in .sbx-manifest | .sbx-commit) echo "sbx: commit $full has its own $path; push-git writes that file" >&2; return 1 ;; esac
		[ -n "$mode" ] && [ -n "$sha" ] || { echo "sbx: bad ls-tree entry '$rec'" >&2; return 1; }
		printf '%s %s\0' "$sha" "$path" >> "$out.body"
	done < "$raw"
	{
		printf 'commit %s\n' "$full"
		LC_ALL=C sort -z -t ' ' -k 2 < "$out.body" | tr '\0' '\n'
	} > "$out" || return 1
	rm -f "$raw" "$out.body"
}

# pg_verify_tar GIT_DIR TAR MANIFEST CHECK_DIR: the archive holds exactly the manifest's files
# plus the manifest, and each file hashes to its blob id. A .gitattributes rule (eol=crlf,
# export-subst, export-ignore, ident, filter) can make git archive write other bytes than the
# blob; then the manifest would be wrong on the box, so push-git stops here.
pg_verify_tar() {
	local gd=$1 tar=$2 man=$3 chk=$4 line sha p want got n
	mkdir -p "$chk"
	tar -xf "$tar" -C "$chk" || { echo "sbx: local extract of the archive failed" >&2; return 1; }
	cmp -s "$man" "$chk/.sbx-manifest" || { echo "sbx: the archive's .sbx-manifest differs from the one written" >&2; return 1; }
	want=$(wc -l < "$man" | tr -d ' ')  # n files + the commit line = n files + the manifest itself
	n=$(find "$chk" \( -type f -o -type l \) | wc -l | tr -d ' ')
	[ "$n" = "$want" ] || { echo "sbx: the archive has $n files, the manifest names $((want - 1)) plus itself (a .gitattributes export-ignore?)" >&2; return 1; }
	: > "$chk.paths"; : > "$chk.rel"; : > "$chk.want"
	while IFS= read -r line; do
		sha=${line%% *}; p=${line#* }
		if [ -L "$chk/$p" ]; then
			got=$(printf '%s' "$(readlink "$chk/$p")" | git -C "$gd" hash-object --stdin) || return 1
			[ "$got" = "$sha" ] || { echo "sbx: archive symlink $p hashes to $got, the commit has $sha" >&2; return 1; }
		elif [ -f "$chk/$p" ]; then
			printf '%s\n' "$chk/$p" >> "$chk.paths"; printf '%s\n' "$p" >> "$chk.rel"; printf '%s\n' "$line" >> "$chk.want"
		else
			echo "sbx: the archive has no file $p" >&2; return 1
		fi
	done < <(sed 1d "$man")
	git -C "$gd" hash-object --no-filters --stdin-paths < "$chk.paths" > "$chk.got" || return 1
	paste -d ' ' "$chk.got" "$chk.rel" | cmp -s - "$chk.want" || {
		echo "sbx: archive bytes differ from the commit's blobs (a .gitattributes eol=crlf, export-subst, ident or filter rule?):" >&2
		paste -d ' ' "$chk.got" "$chk.rel" | diff "$chk.want" - | sed -n '1,10p' >&2
		return 1
	}
	rm -rf "$chk" "$chk.paths" "$chk.rel" "$chk.want" "$chk.got"
}

# pg_build GIT_DIR FULL_COMMIT DIR -> DIR/.sbx-manifest and DIR/src.tar.zst (manifest inside).
pg_build() {
	local gd=$1 full=$2 dir
	dir=$(cd "$3" && pwd) || return 1  # git -C changes the cwd: --add-file needs an absolute path
	sbx_manifest "$gd" "$full" "$dir/.sbx-manifest" || return 1
	# Reads committed objects only; never touches the worktree, index or HEAD.
	git -C "$gd" archive --format=tar --add-file="$dir/.sbx-manifest" "$full" > "$dir/src.tar" || { echo "sbx: git archive failed" >&2; return 1; }
	pg_verify_tar "$gd" "$dir/src.tar" "$dir/.sbx-manifest" "$dir/chk" || return 1
	zstd -q -T0 -6 -f -o "$dir/src.tar.zst" "$dir/src.tar" || return 1
	rm -f "$dir/src.tar"
}

# pg_remote_script REMOTE_DIR REMOTE_TAR FULL_COMMIT CLEAR -> the bash the box runs.
# Exit 93: refused (REMOTE_DIR is not an empty dir and CLEAR is 0, or it is not a dir, or its
# physical path is / or holds UPLOAD_DIR); the upload is removed and REMOTE_DIR is not touched.
# The box resolves REMOTE_DIR first (cd -P): a symlink in an ancestor can make a path that
# passed pg_check_remote_dir name /work or /; every step after that uses the resolved dir.
pg_remote_script() {
	local rd rt up
	rd=$(q "$1"); rt=$(q "$2"); up=$(q "$UPLOAD_DIR")
	cat <<-SCRIPT
	set -eo pipefail; rd=$rd; rt=$rt; up=$up
	refuse() { rm -f "\$rt"; echo "sbx push-git: refused: \$1" >&2; exit 93; }
	if [ -L "\$rd" ]; then refuse "\$rd is a symlink"; fi
	if [ -e "\$rd" ] && [ ! -d "\$rd" ]; then refuse "\$rd exists and is not a directory"; fi
	[ -d "\$rd" ] || mkdir -p "\$rd"
	pd=\$(CDPATH= cd -P -- "\$rd" && pwd -P) || refuse "cannot resolve \$rd"
	pu=\$(CDPATH= cd -P -- "\$up" && pwd -P) || refuse "cannot resolve the upload dir \$up"
	if [ "\$pd" = / ]; then refuse "\$rd is / on the box"; fi
	case "\$pu/" in "\$pd"/*) refuse "\$rd is \$pd on the box, which holds the upload dir \$pu" ;; esac
	rd=\$pd
	if [ -n "\$(ls -A "\$rd")" ]; then
		if [ $4 = 1 ]; then
			echo "sbx push-git: --clear: deleting the \$(ls -A "\$rd" | wc -l | tr -d ' ') entries of \$rd" >&2
			find "\$rd" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
		else
			refuse "\$rd is not empty (\$(ls -A "\$rd" | wc -l | tr -d ' ') entries); pass --clear to delete its contents first, or use a new dir"
		fi
	fi
	zstd -q -dc "\$rt" | tar -xf - -C "\$rd"
	rm -f "\$rt"
	printf '%s\n' $3 > "\$rd/.sbx-commit"
	echo "extracted \$(find "\$rd" \( -type f -o -type l \) | wc -l | tr -d ' ') files"
	SCRIPT
}

cmd_push_git() {
	local full rtar out ec
	pg_parse_args "$@"
	command -v git >/dev/null || die "need git"
	command -v zstd >/dev/null || die "need zstd"
	case "$(git archive -h 2>&1 || true)" in *add-file*) ;; *) die "git archive has no --add-file (git too old)" ;; esac
	full=$(git -C "$PG_GD" rev-parse --verify --quiet "$PG_COMMIT^{commit}") || die "unknown commit $PG_COMMIT in $PG_GD"
	mkdir -p "$WORK/pg"
	pg_build "$PG_GD" "$full" "$WORK/pg" || { echo "sbx: push-git: nothing was sent" >&2; exit 92; }
	sbx_init_remote
	echo "sbx: push-git $PG_GD@$full ($(file_size "$WORK/pg/src.tar.zst") B zstd, $(($(wc -l < "$WORK/pg/.sbx-manifest") - 1)) files) -> $PG_ID:$PG_RD" >&2
	rtar="$UPLOAD_DIR/git-$full.tar.zst"
	cmd_put "$PG_ID" "$WORK/pg/src.tar.zst" "$rtar"
	out="$WORK/pg/extract.json"
	rexec "$PG_ID" "$(pg_remote_script "$PG_RD" "$rtar" "$full" "$PG_CLEAR")" 1200 "$out" || exit 98
	ec=$(jq -r '.exitCode' "$out")
	if [ "$ec" = 93 ]; then jq -j '.stderr' "$out" >&2; exit 93; fi
	if [ "$ec" != 0 ]; then
		echo "sbx: push-git extract on $PG_ID failed (exit $ec)" >&2
		jq -j '.stderr' "$out" >&2; jq -j '.stdout' "$out" >&2
		exit 98
	fi
	jq -j '.stdout' "$out"
	echo >&2
}

cmd_manifest() {
	[ $# -eq 2 ] || die "usage: sbx manifest <git-dir> <commit>"
	local full
	command -v git >/dev/null || die "need git"
	full=$(git -C "$1" rev-parse --verify --quiet "$2^{commit}") || die "unknown commit $2 in $1"
	sbx_manifest "$1" "$full" "$WORK/manifest" || exit 92
	cat "$WORK/manifest"
}

cmd_bg() {
	[ $# -eq 3 ] || die "usage: sbx bg <id> <job-name> '<cmd>'"
	local id=$1 job=$2 cmd=$3 script="$WORK/job.sh" j="/work/jobs/$2"
	check_id "$id"; check_job "$job"
	printf '%s\n' "$cmd" > "$script"
	mkdir -p "$WORK/bgparts"; cp "$script" "$WORK/bgparts/s"
	write_chunk "$id" "$WORK/bgparts/s" "$j.sh" || exit 98
	# setsid + nohup: the job survives the /exec request that launched it.
	rexec_ok "$id" "set -e; rm -f $j.log $j.exit $j.pid; cd /work; nohup setsid bash -c 'bash $j.sh > $j.log 2>&1 < /dev/null; echo \$? > $j.exit.tmp; mv -f $j.exit.tmp $j.exit' > /dev/null 2>&1 < /dev/null & echo \$! > $j.pid; sleep 0.2; echo started job $job pid \$(cat $j.pid)" 60 || exit 98
}

cmd_wait() {
	[ $# -ge 2 ] || die "usage: sbx wait <id> <job-name> [poll_s]"
	local id=$1 job=$2 poll=${3:-20} j="/work/jobs/$2" off=0 out="$WORK/wait.json" st sz fails=0
	check_id "$id"; check_job "$job"
	[[ "$poll" =~ ^[0-9]+$ ]] && [ "$poll" -ge 1 ] && [ "$poll" -le 1500 ] || die "poll_s must be 1..1500 (keep it under the 30 min idle timeout)"
	while :; do
		# One request per poll: status line, then up to 4 MiB of new log bytes as base64.
		rexec "$id" "if [ -f $j.exit ]; then st=\$(cat $j.exit); elif [ -f $j.pid ] && kill -0 \$(cat $j.pid) 2>/dev/null; then st=running; elif [ -f $j.pid ]; then st=lost; else st=missing; fi; sz=\$(stat -c %s $j.log 2>/dev/null || echo 0); echo \"\$st \$sz\"; tail -c +$((off + 1)) $j.log 2>/dev/null | head -c 4194304 | base64 -w0" 120 "$out" || {
			fails=$((fails + 1)); [ "$fails" -le 10 ] || { echo "sbx: wait: 10 failed polls in a row, giving up" >&2; exit 98; }
			sleep "$poll"; continue; }
		fails=0
		st=$(jq -r '.stdout' "$out" | sed -n 1p | cut -d' ' -f1)
		sz=$(jq -r '.stdout' "$out" | sed -n 1p | cut -d' ' -f2)
		jq -r '.stdout' "$out" | sed -n 2p > "$WORK/wait.b64"
		if [ -s "$WORK/wait.b64" ]; then
			b64dec < "$WORK/wait.b64" > "$WORK/wait.bin"
			cat "$WORK/wait.bin"
			off=$((off + $(file_size "$WORK/wait.bin")))
		fi
		case "$st" in
			running) ;;
			missing) echo "sbx: job $job not found on $id (was the sandbox restarted?)" >&2; exit 96 ;;
			lost) [ "$off" -ge "$sz" ] && { echo "sbx: job $job died without an exit file" >&2; exit 95; } ;;
			*) if [ "$off" -ge "$sz" ]; then echo "sbx: job $job exited $st" >&2; exit "$st"; fi ;;
		esac
		[ "$off" -lt "$sz" ] && continue   # more log to fetch right away
		sleep "$poll"
	done
}

cmd_destroy() {
	[ $# -eq 1 ] || die "usage: sbx destroy <id>"
	local id=$1 body="$WORK/d.json" out="$WORK/d.out" code
	check_id "$id"
	jq -n --arg id "$id" '{id:$id}' > "$body"
	code=$(api POST /destroy "$body" "$out" 120)
	cat "$out"; echo
	# A container that still runs after destroy keeps billing: never exit 0 then.
	if [ "$(jq -r '.runningAfter' "$out" 2>/dev/null)" = true ]; then
		echo "sbx: destroy did not stop the container of $id (runningAfter true); it still runs and bills; run 'sbx destroy $id' again" >&2
		exit 94
	fi
	[ "$code" = 200 ] && [ "$(jq -r '.ok' "$out" 2>/dev/null)" = true ] || exit 98
}

cmd_health() {
	local out="$WORK/h.out" code path=/health
	if [ $# -ge 1 ]; then check_id "$1"; path="/health?id=$1"; fi
	code=$(api GET "$path" "" "$out" 60)
	cat "$out"; echo
	[ "$code" = 200 ] || exit 98
}

sbx_main() {
	local sub=${1:-}
	[ $# -gt 0 ] && shift
	case "$sub" in
		push-git) sbx_make_work; cmd_push_git "$@" ;;  # local checks first, then sbx_init_remote
		manifest) sbx_make_work; cmd_manifest "$@" ;;  # local only: no URL, no token
		exec | put | get | bg | wait | destroy | health)
			sbx_init_remote; sbx_make_work
			case "$sub" in
				exec) cmd_exec "$@" ;;
				put) cmd_put "$@" ;;
				get) cmd_get "$@" ;;
				bg) cmd_bg "$@" ;;
				wait) cmd_wait "$@" ;;
				destroy) cmd_destroy "$@" ;;
				health) cmd_health "$@" ;;
			esac
			;;
		*) sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
	esac
}

# Sourced (tests/push-git-local.sh): define the functions only.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then sbx_main "$@"; fi
